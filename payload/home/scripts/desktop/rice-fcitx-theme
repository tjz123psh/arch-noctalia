#!/usr/bin/env bash
# rice-fcitx-theme — 给 Noctalia 生成的 fcitx5 主题补透明度（候选窗/菜单背景）。
# 由 Noctalia hooks（colors_changed）调用：换壁纸 / 切明暗 / 换调色板后，Noctalia 会
# 重渲染主题（写回 6 位不透明色）；本脚本再把两个背景色统一写成 8 位 #AARRGGBB，
# 并让运行中的 Fcitx5 立即重载。
# 调整透明度：改下面 ALPHA（两位十六进制；FF=不透明、CC≈80%、99≈60%、66≈40%、33≈20%）。
set -euo pipefail

ALPHA="CC"
THEME="${XDG_DATA_HOME:-$HOME/.local/share}/fcitx5/themes/noctalia/theme.conf"

[ -f "$THEME" ] || exit 0

result="$(python3 - "$THEME" "$ALPHA" <<'PY'
import pathlib, re, sys

theme, alpha = pathlib.Path(sys.argv[1]), sys.argv[2]
s = theme.read_text()

def fix(text, block):
    pat = re.compile(r'(\[' + re.escape(block) + r'\]\nColor=#)(?:[0-9A-Fa-f]{2})?([0-9A-Fa-f]{6})\b')
    return pat.sub(lambda m: m.group(1) + alpha + m.group(2), text)

new = fix(fix(s, 'InputPanel/Background'), 'Menu/Background')
if new != s:
    theme.write_text(new)
    print('updated')
else:
    print('unchanged')
PY
)"

if [[ "$result" == "updated" ]]; then
    busctl --user call org.fcitx.Fcitx5 /controller org.fcitx.Fcitx.Controller1 ReloadAddonConfig s classicui >/dev/null 2>&1 || true
fi
printf 'rice-fcitx-theme: %s (alpha=%s)\n' "$result" "$ALPHA"
