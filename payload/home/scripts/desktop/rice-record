#!/bin/bash
# rice-record — 录屏开关（再执行一次即停止）
# 优先 gpu-screen-recorder；不支持的环境（如本 VM 的 VMware 显卡）自动回退 wf-recorder。
# 文件落在 ~/Videos/rec-<时间>.mp4

set -u

DIR="$HOME/Videos"
mkdir -p "$DIR"

export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
if [ -z "${WAYLAND_DISPLAY:-}" ]; then
    sock=$(ls "$XDG_RUNTIME_DIR"/wayland-[0-9]* 2>/dev/null | grep -v '\.lock$' | head -1)
    [ -n "$sock" ] && export WAYLAND_DISPLAY=$(basename "$sock")
fi

# 停止分支
if pgrep -x wf-recorder >/dev/null; then
    pkill -INT -x wf-recorder
    sleep 0.4
    notify-send -a 录屏 "已停止（wf-recorder）" "文件在 ~/Videos" 2>/dev/null || true
    exit 0
fi
if pgrep -f gpu-screen-recorder >/dev/null; then
    pkill -INT -f gpu-screen-recorder
    sleep 0.6
    notify-send -a 录屏 "已停止（gpu-screen-recorder）" "文件在 ~/Videos" 2>/dev/null || true
    exit 0
fi

# 开始分支
out="$DIR/rec-$(date +%Y%m%d-%H%M%S).mp4"

if command -v gpu-screen-recorder >/dev/null 2>&1; then
    gpu-screen-recorder -w screen -f 60 -o "$out" >/tmp/rice-record.log 2>&1 &
    gsr=$!
    sleep 1.2
    if kill -0 "$gsr" 2>/dev/null; then
        notify-send -a 录屏 "开始录制（gpu-screen-recorder）" "再按一次 Alt+Shift+D 停止" 2>/dev/null || true
        wait "$gsr"
        exit $?
    fi
    rm -f "$out"
fi

notify-send -a 录屏 "开始录制（wf-recorder）" "再按一次 Alt+Shift+D 停止" 2>/dev/null || true
exec wf-recorder -f "$out"
