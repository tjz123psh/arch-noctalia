#!/usr/bin/env bash
# rice-fcitx5-glass — 让 fcitx5 候选窗跟随桌面色板，并带半透明圆角背板。
#
# 背景：Noctalia 每次换壁纸/切深浅都会重写 ~/.local/share/fcitx5/themes/noctalia/theme.conf，
#       任何手改都会被冲掉。所以这里作为 Noctalia 的 colors_changed 钩子运行：
#       1) 从刚生成的主题里读当前配色（背景色/边框色）；
#       2) 用**纯 Python 标准库**（无 Pillow）画一张圆角、半透明、带描边的背板 PNG；
#       3) 幂等地把 Image=/EnableBlur/BlurMargin 打进主题（Noctalia 重写后需要重打）。
# 只读主题、只写主题目录与一行日志；失败不阻塞其它钩子（退出码仍如实返回）。
set -Eeuo pipefail

THEME_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/fcitx5/themes/noctalia"
THEME_CONF="$THEME_DIR/theme.conf"
LOG="${XDG_CACHE_HOME:-$HOME/.cache}/rice-fcitx5-glass.log"

log() { printf '%s %s\n' "$(date '+%F %T')" "$*" >>"$LOG" 2>/dev/null || true; }

[[ -f "$THEME_CONF" ]] || { log "theme.conf 不存在，跳过"; exit 0; }
command -v python3 >/dev/null 2>&1 || { log "没有 python3，跳过"; exit 0; }

python3 - "$THEME_CONF" <<'PY'
import pathlib, re, struct, sys, zlib

conf = pathlib.Path(sys.argv[1])
txt = conf.read_text()

def section(name):
    m = re.search(rf'^\[{re.escape(name)}\]\s*$([\s\S]*?)(?=^\[|\Z)', txt, re.M)
    return m.group(1) if m else ''

def colour(sec, key, default):
    m = re.search(rf'^{re.escape(key)}=(#?[0-9a-fA-F]{{6}})\s*$', section(sec), re.M)
    return m.group(1) if m else default

base = colour('InputPanel/Background', 'Color', '#272a2f')
edge = colour('InputPanel/Background', 'BorderColor', '#9ecafc')
rgb = lambda c: tuple(int(c[i:i+2], 16) for i in (1, 3, 5))
b, e = rgb(base), rgb(edge)

# 背板比色板底色再暗一点 + 91% 不透明：既保留玻璃感，又保证候选字够清楚
ALPHA, DARKEN, RADIUS, BORDER = 232, 0.80, 12, 2
fill = tuple(max(0, int(v * DARKEN)) for v in b)

def png(w, h, rows):
    def chunk(tag, data):
        return (struct.pack('>I', len(data)) + tag + data
                + struct.pack('>I', zlib.crc32(tag + data) & 0xffffffff))
    raw = b''.join(b'\x00' + r for r in rows)
    return (b'\x89PNG\r\n\x1a\n'
            + chunk(b'IHDR', struct.pack('>IIBBBBB', w, h, 8, 6, 0, 0, 0))
            + chunk(b'IDAT', zlib.compress(raw, 9))
            + chunk(b'IEND', b''))

def plate(w=64, h=64):
    rows = []
    for y in range(h):
        row = bytearray()
        for x in range(w):
            # 到最近圆角圆心的距离（只在四个角生效）
            dx = RADIUS - x if x < RADIUS else (x - (w - 1 - RADIUS) if x > w - 1 - RADIUS else 0)
            dy = RADIUS - y if y < RADIUS else (y - (h - 1 - RADIUS) if y > h - 1 - RADIUS else 0)
            if dx > 0 and dy > 0:
                d = (dx * dx + dy * dy) ** 0.5
                if d > RADIUS:
                    row += bytes((0, 0, 0, 0)); continue
                inset = RADIUS - d
            else:
                inset = min(x, y, w - 1 - x, h - 1 - y)
            if inset < BORDER:
                row += bytes((*e, 255))
            else:
                row += bytes((*fill, ALPHA))
        rows.append(bytes(row))
    return png(w, h, rows)

for name in ('panel', 'menu'):
    (conf.parent / f'{name}.png').write_bytes(plate())

# 幂等打补丁：Image / Margins / Blur（Noctalia 重写后会丢，需要每次补）
def ensure_section(name, body, after):
    global txt
    if f'[{name}]' in txt:
        return
    txt = txt.replace(after, after + body, 1)

if 'EnableBlur=True' not in section('InputPanel'):
    txt = txt.replace('[InputPanel]\n', '[InputPanel]\nEnableBlur=True\n', 1)
ensure_section('InputPanel/BlurMargin',
               '\n[InputPanel/BlurMargin]\nLeft=10\nRight=10\nTop=10\nBottom=10\n',
               '[InputPanel]\nEnableBlur=True\n')
if not re.search(r'^Image=panel\.png$', section('InputPanel/Background'), re.M):
    txt = txt.replace('[InputPanel/Background]\n', '[InputPanel/Background]\nImage=panel.png\n', 1)
if '[InputPanel/Background/Margin]' not in txt:
    txt = txt.replace('[InputPanel/Background]\nImage=panel.png\n',
                      '[InputPanel/Background]\nImage=panel.png\n\n[InputPanel/Background/Margin]\n'
                      'Left=12\nRight=12\nTop=12\nBottom=12\n', 1)
if '[Menu/Background/Margin]' not in txt:
    txt = txt.replace('[Menu/Background]\n', '[Menu/Background]\nImage=menu.png\n', 1)
    txt = txt.replace('[Menu/Background]\nImage=menu.png\n',
                      '[Menu/Background]\nImage=menu.png\n\n[Menu/Background/Margin]\n'
                      'Left=12\nRight=12\nTop=12\nBottom=12\n', 1)
conf.write_text(txt)
print(f'glass: base={base} fill={fill} alpha={ALPHA} border={edge} radius={RADIUS}')
PY
rc=$?
if (( rc == 0 )); then log "背板已重画并打补丁（$THEME_CONF）"; else log "渲染失败 rc=$rc"; fi
exit $rc
