#!/usr/bin/env bash
# rice-hotspot — 一键开关 Wi-Fi 热点（NetworkManager 的 AP 模式 + shared NAT）。
#
# 用法：rice-hotspot [on|off|toggle|status|password]     默认 toggle
#
# 配置（可选）：~/.config/rice-hotspot.conf
#   RICE_HOTSPOT_SSID="..."       默认 <主机名>-hotspot
#   RICE_HOTSPOT_PASSWORD="..."   默认首次自动生成（12 位十六进制）并存到状态目录（600）
#   RICE_HOTSPOT_BAND="bg"|"a"    默认 bg（2.4GHz，兼容性最好）
#   RICE_HOTSPOT_IFACE="wlp3s0"   默认自动选第一个 Wi-Fi 设备
#
# 依赖：NetworkManager（nmcli）+ dnsmasq（shared 模式的 DHCP/DNS，安装器已带）。
# 注意：一块网卡不能同时既连 Wi-Fi 又发热点——开热点会顶掉当前 Wi-Fi 客户端连接
#       （关掉后会尽量把原来那条连回来）；有线连接不受影响。
set -Eeuo pipefail

CONN="rice-hotspot"
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/rice-hotspot"
PW_FILE="${STATE_DIR}/password"
PREV_FILE="${STATE_DIR}/prev-wifi"
CONF="${XDG_CONFIG_HOME:-$HOME/.config}/rice-hotspot.conf"

info()   { printf '[info]  %s\n' "$*"; }
warn()   { printf '[warn]  %s\n' "$*" >&2; }
die()    { printf '[error] %s\n' "$*" >&2; exit 1; }
have()   { command -v "$1" >/dev/null 2>&1; }
notify() { have notify-send && notify-send -a rice-hotspot -i network-wireless "$@" >/dev/null 2>&1 || true; }

usage() {
  cat <<'EOF'
rice-hotspot — Wi-Fi 热点开关（NetworkManager AP + shared NAT）

用法:
  rice-hotspot            切换（开着就关，关着就开）
  rice-hotspot on         打开热点
  rice-hotspot off        关闭热点
  rice-hotspot status     查看状态（SSID / 密码 / 网关）
  rice-hotspot password   只打印当前密码
  rice-hotspot state      单行机器可读状态（on|在用SSID|设备|网关|期望SSID|待应用 / off|期望SSID|||期望SSID|0）

改设置（SSID/密码/频段）后：正在跑的热点不会自己变——再跑一次 on 会重启它并应用新值
（侧栏面板上的按钮会显示「应用」）。

装了 Docker 的机器：Docker 的 FORWARD 策略是 drop，会挡掉热点客户端的转发（表现为"连上但
没网"）。本脚本会调 /usr/local/bin/rice-hotspot-net 往 DOCKER-USER 链放行；没有 root 权限时
会明确提示手动补一次。

配置（可选，~/.config/rice-hotspot.conf）:
  RICE_HOTSPOT_SSID="..."       默认 <主机名>-hotspot
  RICE_HOTSPOT_PASSWORD="..."   默认首次自动生成并存到 ~/.local/state/rice-hotspot/password
  RICE_HOTSPOT_BAND="bg"|"a"    默认 bg（2.4GHz）
  RICE_HOTSPOT_IFACE="wlp3s0"   默认自动挑第一个 Wi-Fi 设备

优先级：环境变量（Noctalia 插件「Sidebar · 随手工作台」的热点设置会以环境变量传进来）
        > ~/.config/rice-hotspot.conf > 上次开热点时记住的值（~/.local/state/rice-hotspot/）
        > 内置默认（<主机名>-hotspot / 首次自动生成的密码）。
EOF
}

have nmcli || die "nmcli 未找到：本脚本需要 NetworkManager"

# 并发锁：面板按钮/命令行/IPC 同时来两下时，第二个直接退，别让两次操作互相打架
mkdir -p "$STATE_DIR"
exec 9>"$STATE_DIR/lock"
if ! flock -n 9; then
  die "上一次热点操作还在进行，稍等几秒再试（rice-hotspot state 可看进度）"
fi

# 取值优先级：环境变量（Noctalia 插件设置传进来）> ~/.config/rice-hotspot.conf
# > 状态目录里记住的值 > 内置默认。插件里改过 SSID/密码后，命令行也沿用同一套。
ENV_SSID="${RICE_HOTSPOT_SSID:-}"
ENV_PW="${RICE_HOTSPOT_PASSWORD:-}"
ENV_BAND="${RICE_HOTSPOT_BAND:-}"
ENV_IFACE="${RICE_HOTSPOT_IFACE:-}"

if [[ -f "$CONF" ]]; then
  # shellcheck disable=SC1090
  source "$CONF"
fi

BAND_EXPLICIT=0
if [[ -n "${ENV_BAND:-}${RICE_HOTSPOT_BAND:-}" ]]; then BAND_EXPLICIT=1; fi
STATE_SSID="$(cat "${STATE_DIR}/ssid" 2>/dev/null || true)"
SSID="${ENV_SSID:-${RICE_HOTSPOT_SSID:-${STATE_SSID:-$(cat /etc/hostname 2>/dev/null || echo arch)-hotspot}}}"
BAND="${ENV_BAND:-${RICE_HOTSPOT_BAND:-bg}}"
IFACE="${ENV_IFACE:-${RICE_HOTSPOT_IFACE:-}}"

# 配置里给的密码（环境变量优先）——空 = 用/生成状态目录里的
cfg_password() { printf '%s' "${ENV_PW:-${RICE_HOTSPOT_PASSWORD:-}}"; }

pick_iface() {
  if [[ -n "$IFACE" ]]; then printf '%s' "$IFACE"; return 0; fi
  local d
  d="$(LC_ALL=C nmcli -t -f DEVICE,TYPE device status 2>/dev/null | awk -F: '$2=="wifi"{print $1; exit}')"
  [[ -n "$d" ]] || die "没找到 Wi-Fi 设备（nmcli device status）"
  printf '%s' "$d"
}

is_up()        { LC_ALL=C nmcli -t -f NAME connection show --active 2>/dev/null | grep -Fxq "$CONN"; }

# profile 里现在存着的值（用来判断"改了设置但热点还在用旧值"）
profile_ssid() { LC_ALL=C nmcli -t -f 802-11-wireless.ssid connection show "$CONN" 2>/dev/null | cut -d: -f2-; }
profile_band() { LC_ALL=C nmcli -t -f 802-11-wireless.band connection show "$CONN" 2>/dev/null | cut -d: -f2-; }

# 这次的配置跟"上次成功应用的值"不一致？1 = 要重启热点才能生效。
# 注意：跟"记住的期望值"比，而不是跟 profile 的实际频段比——因为 5G 起不来会回落到
# 2.4G，那是已生效状态，不该永远显示"待应用"。
hotspot_pending() {
  conn_exists || { printf 0; return 0; }
  local want_pw
  want_pw="$(ensure_password)"
  [[ -s "${STATE_DIR}/ssid" && "$(cat "${STATE_DIR}/ssid")" == "$SSID" ]] || { printf 1; return 0; }
  [[ -s "$PW_FILE" && "$(cat "$PW_FILE")" == "$want_pw" ]] || { printf 1; return 0; }
  # 频段只有被显式指定（环境变量/配置文件）时才比较；裸命令行调用不该报「待应用」
  if [[ "${BAND_EXPLICIT:-0}" == "1" ]]; then
    [[ -f "${STATE_DIR}/band_desired" && "$(cat "${STATE_DIR}/band_desired")" == "$BAND" ]] || { printf 1; return 0; }
  fi
  # 顺手防外部把 profile 改了
  [[ "$(profile_ssid)" == "$SSID" ]] || { printf 1; return 0; }
  printf 0
}
conn_exists()  { LC_ALL=C nmcli -t -f NAME connection show 2>/dev/null | grep -Fxq "$CONN"; }
radio_on()     { LC_ALL=C nmcli -t -f WIFI radio 2>/dev/null | grep -qx 'enabled'; }
active_wifi()  { LC_ALL=C nmcli -t -f NAME,TYPE connection show --active 2>/dev/null | awk -F: '$2=="802-11-wireless"{print $1; exit}'; }

# 生成/读取密码（会落地保存）
ensure_password() {
  local p
  p="$(cfg_password)"
  if [[ -n "$p" ]]; then printf '%s' "$p"; return 0; fi
  if [[ -s "$PW_FILE" ]]; then cat "$PW_FILE"; return 0; fi
  mkdir -p "$STATE_DIR" && chmod 700 "$STATE_DIR"
  local pw
  pw="$(od -An -tx1 -N24 /dev/urandom | tr -d ' \n' | cut -c1-12)"
  printf '%s' "$pw" > "$PW_FILE"
  chmod 600 "$PW_FILE"
  printf '%s' "$pw"
}

# 只读：密码已知就显示，不知道就留空（不会因此生成新密码）
peek_password() {
  local p
  p="$(cfg_password)"
  if [[ -n "$p" ]]; then printf '%s' "$p"; return 0; fi
  [[ -s "$PW_FILE" ]] && cat "$PW_FILE" || true
}

ensure_radio() {
  if ! radio_on; then
    info "Wi-Fi 无线电当前是关的，先打开"
    LC_ALL=C nmcli radio wifi on >/dev/null 2>&1 || rfkill unblock wifi >/dev/null 2>&1 || true
    sleep 1
  fi
  radio_on || die "Wi-Fi 打不开（可能被 rfkill 软锁）：试 sudo rfkill unblock wifi，或看 nmcli radio"
}

show_status() {
  if is_up; then
    local iface ip pw actual
    iface="$(pick_iface)"
    ip="$(LC_ALL=C nmcli -t -f IP4.ADDRESS device show "$iface" 2>/dev/null | awk -F: 'NR==1{print $2}')"
    pw="$(peek_password)"
    actual="$(profile_ssid)"
    printf '热点: 已开启\nSSID: %s\n' "${actual:-$SSID}"
    if [[ -n "$pw" ]]; then printf '密码: %s\n' "$pw"; fi
    printf '网关: %s\n设备: %s\n' "${ip:-未知}" "$iface"
    if [[ "$(hotspot_pending)" == "1" ]]; then
      printf '注意: 设置改了但还没生效（期望 SSID=%s 频段=%s）——重跑 on，或点侧栏面板上的「应用」\n' "$SSID" "$BAND"
    fi
  else
    printf '热点: 未开启\nSSID: %s（开的时候用）\n' "$SSID"
  fi
}

# --- Docker 共存：放行热点子网的转发 -------------------------------------------------
# 装了 Docker 的机器上，Docker 把 nftables 的 FORWARD 链策略设成 drop；NetworkManager 的
# shared 规则虽然 accept 了热点子网，但 nftables 里 accept 不是跨基链的最终裁决，包照样被
# Docker 那条 drop 吃掉 —— 现象就是「手机连上了、拿到 IP，但上不了网」。Docker 官方留了
# DOCKER-USER 链给用户放行，这里调用 root 助手（/usr/local/bin/rice-hotspot-net）去做。
NET_HELPER="${RICE_HOTSPOT_NET_HELPER:-/usr/local/bin/rice-hotspot-net}"

net_subnet() { # 从 AP 接口地址推网段（NetworkManager shared 默认 /24）
  local iface="$1" addr
  addr="$(LC_ALL=C ip -o -4 addr show dev "$iface" 2>/dev/null | awk '{print $4; exit}')"
  [[ -n "$addr" ]] || return 0
  printf '%s.0/24' "${addr%.*}"
}

net_up() {
  local iface="$1" subnet
  subnet="$(net_subnet "$iface")"
  [[ -n "$subnet" ]] || { warn "拿不到 ${iface} 的网段，跳过转发放行"; return 0; }
  mkdir -p "$STATE_DIR"; printf '%s' "$subnet" > "${STATE_DIR}/net_subnet"
  [[ -x "$NET_HELPER" ]] || { warn "缺 ${NET_HELPER}：装了 Docker 的机器上热点客户端可能上不了网"; return 0; }
  if sudo -n "$NET_HELPER" up "$iface" "$subnet" >/dev/null 2>&1; then
    return 0
  fi
  warn "转发放行没成功（需要 root，且本机装了 Docker 的 FORWARD policy=drop）——手机可能上不了网"
  warn "手动补一次： ~/scripts/desktop/gsudo $NET_HELPER up $iface $subnet"
}

net_down() {
  local iface="$1" subnet
  subnet="$(cat "${STATE_DIR}/net_subnet" 2>/dev/null || net_subnet "$iface")"
  [[ -n "$subnet" && -x "$NET_HELPER" ]] || return 0
  sudo -n "$NET_HELPER" down "$iface" "$subnet" >/dev/null 2>&1 || true
  rm -f "${STATE_DIR}/net_subnet"
}

# 按当前 SSID/BAND/密码 建或改 profile，并试着拉起来。成功 0，失败 1（不 die，交给调用方决定回落/回滚）。
start_ap() { # $1=iface $2=密码 $3=频段
  local iface="$1" pw="$2" band="${3:-$BAND}" rc=0
  if conn_exists; then
    LC_ALL=C nmcli connection modify "$CONN" \
      802-11-wireless.ssid "$SSID" \
      802-11-wireless.band "$band" \
      802-11-wireless-security.key-mgmt wpa-psk \
      802-11-wireless-security.psk "$pw" >/dev/null 2>&1 || true
    # 单次拉起最多等 12s：AP 起不来时 NM 自己要等 ~26s（802.1X 请求方超时），
    # 等太久会把整条命令拖到调用方（面板/命令行）的超时里去。
    LC_ALL=C timeout 12 nmcli connection up "$CONN" >/dev/null 2>&1 || rc=$?
    if (( rc != 0 )); then
      LC_ALL=C nmcli connection down "$CONN" >/dev/null 2>&1 || true   # 取消这次没起来的激活
      sleep 1
    fi
  else
    nmcli device wifi hotspot con-name "$CONN" ifname "$iface" ssid "$SSID" band "$band" password "$pw" >/dev/null 2>&1 || rc=$?
    if (( rc != 0 )); then
      nmcli connection delete "$CONN" >/dev/null 2>&1 || true   # 清掉半成品，免得下次踩到
    else
      LC_ALL=C nmcli connection modify "$CONN" connection.autoconnect no >/dev/null 2>&1 || true
    fi
  fi
  (( rc == 0 )) && is_up && return 0
  return 1
}

do_on() {
  local iface pw prev had_old=0 old_ssid="" old_band="" old_pw="" want_band
  want_band="$BAND"          # 用户请求的频段（回落只改实际值，不改这个）
  iface="$(pick_iface)"
  pw="$(ensure_password)"
  (( ${#pw} >= 8 )) || die "热点密码至少 8 位（WPA2 要求），当前 ${#pw} 位"
  ensure_radio

  if is_up; then
    if [[ "$(hotspot_pending)" == "0" ]]; then
      info "热点已经开着，配置一致"
      net_up "$iface"        # 幂等补一次转发放行（Docker 重启后会清掉 DOCKER-USER）
      show_status
      return 0
    fi
    # 改了 SSID/密码/频段后，正在跑的热点不会自己变：先记下旧值（失败要能回滚），再停掉重建。
    had_old=1
    old_ssid="$(profile_ssid)"
    old_band="$(profile_band)"
    old_pw="$(cat "$PW_FILE" 2>/dev/null || true)"
    info "热点在跑但配置变了（SSID/密码/频段）——重启一次让它生效"
    nmcli connection down "$CONN" >/dev/null || die "停掉旧热点失败，无法应用新配置"
    sleep 1
  fi

  # 记下当前 Wi-Fi 客户端连接，关热点时连回来
  prev="$(active_wifi || true)"
  if [[ -n "$prev" ]]; then
    mkdir -p "$STATE_DIR"
    printf '%s' "$prev" > "$PREV_FILE"
    info "开热点会断开当前的 Wi-Fi 连接「${prev}」（有线不受影响）"
  fi

  # 先按请求的频段起；起不来且不是 2.4G，就自动回落到 2.4G（部分网卡/驱动的 AP 只能 2.4G）。
  # 注意：回落只影响"实际用哪个频段"，BAND（= 用户请求值）保持不变，否则待应用状态会一直亮着。
  local eff_band="$BAND"
  if ! start_ap "$iface" "$pw" "$eff_band"; then
    if [[ "$eff_band" != "bg" ]]; then
      warn "按 ${eff_band} 频段起不来（网卡/驱动的 AP 模式不支持或超时），自动回落到 2.4GHz"
      eff_band="bg"
      if ! start_ap "$iface" "$pw" "$eff_band"; then
        rollback_old_ap "$had_old" "$old_ssid" "$old_band" "$old_pw"
        die "打开热点失败：journalctl -u NetworkManager -n 50 看原因"
      fi
      notify "热点已回落 2.4GHz" "SSID ${SSID}"
    else
      rollback_old_ap "$had_old" "$old_ssid" "$old_band" "$old_pw"
      die "打开热点失败：journalctl -u NetworkManager -n 50 看原因"
    fi
  fi

  is_up || { rollback_old_ap "$had_old" "$old_ssid" "$old_band" "$old_pw"; die "热点没起来（NetworkManager 报成功但连接未激活）"; }
  net_up "$iface"      # 让客户端真的能上网（Docker 的 FORWARD drop 会挡住）
  # 记住这次实际生效的 SSID / 密码 / 频段：命令行与面板下次直接沿用
  mkdir -p "$STATE_DIR"
  printf '%s' "$SSID" > "${STATE_DIR}/ssid"
  printf '%s' "$pw" > "$PW_FILE"
  chmod 600 "$PW_FILE"
  printf '%s' "$want_band" > "${STATE_DIR}/band_desired"
  info "热点已开启：SSID=${SSID} 密码=${pw} 频段=${eff_band}$( [[ "$want_band" != "$eff_band" ]] && printf '（请求 %s，已回落）' "$want_band" )"
  notify "热点已开启" "SSID ${SSID} · 密码 ${pw}"
  show_status
}

# 新配置起不来、而之前本来就有一个能用的热点：把旧值写回去尽量恢复，别让手机那边直接断网。
rollback_old_ap() { # $1=had_old $2=旧SSID $3=旧band $4=旧密码
  [[ "$1" == "1" && -n "$2" ]] || return 0
  warn "尝试回滚到原来的热点（SSID=${2}）"
  SSID="$2"
  if start_ap "$(pick_iface)" "${4:-$(ensure_password)}" "${3:-bg}"; then
    info "已回滚：热点仍是 ${2}"
  else
    warn "回滚也没起来——热点现在是关的"
  fi
}

do_off() {
  local prev
  if is_up; then
    net_down "$(pick_iface)"     # 先撤放行（撤不掉也不影响关闭）
    nmcli connection down "$CONN" >/dev/null || die "关闭热点失败"
    info "热点已关闭"
    notify "热点已关闭" "SSID ${SSID}"
  else
    info "热点本来就没开"
  fi
  # 把开热点前的那条 Wi-Fi 连回来（尽力而为）
  if [[ -s "$PREV_FILE" ]]; then
    prev="$(cat "$PREV_FILE")"
    rm -f "$PREV_FILE"
    if [[ -n "$prev" ]] && LC_ALL=C nmcli -t -f NAME connection show | grep -Fxq "$prev"; then
      if LC_ALL=C nmcli connection up "$prev" >/dev/null 2>&1; then
        info "已连回 Wi-Fi：「${prev}」"
      else
        warn "没能自动连回「${prev}」（可能需要密码/认证），在控制中心点一下即可"
      fi
    fi
  fi
}

case "${1:-toggle}" in
  on|up|start)     do_on ;;
  off|down|stop)   do_off ;;
  toggle)          if is_up; then do_off; else do_on; fi ;;
  status|st)       show_status ;;
  state)           # 单行机器可读（给插件用）：
                   #   on|在用SSID|设备|网关|期望SSID|待应用(0/1)      off|期望SSID|||期望SSID|0
                   if is_up; then
                     local_gw="$(LC_ALL=C nmcli -t -f IP4.ADDRESS device show "$(pick_iface)" 2>/dev/null | awk -F: 'NR==1{print $2}')"
                     printf 'on|%s|%s|%s|%s|%s|%s\n' "$(profile_ssid)" "$(pick_iface)" "${local_gw:-}" "$SSID" "$(hotspot_pending)" "$(profile_band)"
                   else
                     printf 'off|%s|||%s|0\n' "$SSID" "$SSID"
                   fi ;;
  password|pw)     ensure_password; printf '\n' ;;
  -h|--help|help)  usage ;;
  *) usage >&2; die "未知参数：${1}" ;;
esac
