#!/usr/bin/env bash
# screenrec-menu — Wayland 录屏菜单（fuzzel UI）
#
# 引擎：gpu-screen-recorder（GPU 编码，功能全）→ wf-recorder（ffmpeg 兜底）
# 目标：全屏 / 区域（slurp 框选）/ 窗口（niri 焦点窗口，取不到坐标时改为框选）
#
# 用法：
#   screenrec-menu                  打开菜单
#   screenrec-menu --start MODE     MODE = fullscreen | region | window
#   screenrec-menu --stop           停止录制
#   screenrec-menu --toggle         录着就停，没录就开全屏
#   screenrec-menu --settings       直接进设置
#   screenrec-menu --status         "recording <秒> <引擎> <文件>" 或 "idle"
#
# 设置项（全部落在 ~/.local/state/screenrec-menu/config，本脚本自建）：
#   编码 / 质量档 / 码率模式 / 帧率 / 分辨率上限 / 容器
#   音频源（关·系统·麦克风·两者）/ 输出设备 / 输入设备
#   保存目录 / 停止后复制路径 / 停止后打开目录
#   光标 / 倒计时 / 时长上限
set -Eeuo pipefail

STATE="${XDG_STATE_HOME:-$HOME/.local/state}/screenrec-menu"
mkdir -p "$STATE"
PIDF="$STATE/pid"; WATCHF="$STATE/watchdog"; OUTF="$STATE/out"; STARTF="$STATE/start"
ENGF="$STATE/engine"; MODEF="$STATE/mode"; LOG="$STATE/last.log"; CONF="$STATE/config"

# 从 niri 会话外调用也要能用：补齐 Wayland 环境
export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
if [[ -z "${WAYLAND_DISPLAY:-}" ]]; then
    for sock in "$XDG_RUNTIME_DIR"/wayland-[0-9]*; do
        [[ -e "$sock" && "$sock" != *.lock ]] || continue
        WAYLAND_DISPLAY=$(basename "$sock")
        export WAYLAND_DISPLAY
        break
    done
fi

have() { command -v "$1" >/dev/null 2>&1; }
notify() { have notify-send && notify-send -a 录屏 "$1" "${2:-}" || true; }
die() { notify "$1" "${2:-}"; printf '%s\n' "$1 ${2:-}" >&2; exit 1; }

# ---------------- 配置 ----------------
cfg_defaults() {
    ENGINE=gsr
    FPS=60
    CODEC=h264
    QUALITY=very_high
    BITMODE=qp
    RES=source
    CONTAINER=mp4
    AUDIO=system
    OUTDEV=default_output
    INDEV=default_input
    CURSOR=yes
    COUNTDOWN=0
    LIMIT=0
    COPY_PATH=yes
    OPEN_AFTER=no
    SAVEDIR="$HOME/Videos"
}
cfg_load() {
    cfg_defaults
    # shellcheck disable=SC1090  # 运行时配置文件，路径由 STATE 决定
    [[ -f "$CONF" ]] && . "$CONF"
    mkdir -p "$SAVEDIR"
    # 首次运行就把默认值落盘，方便用户直接编辑
    [[ -f "$CONF" ]] || cfg_save
}
cfg_save() {
    {
        printf 'ENGINE=%q\nFPS=%q\nCODEC=%q\nQUALITY=%q\nBITMODE=%q\nRES=%q\n' \
            "$ENGINE" "$FPS" "$CODEC" "$QUALITY" "$BITMODE" "$RES"
        printf 'CONTAINER=%q\nAUDIO=%q\nOUTDEV=%q\nINDEV=%q\n' "$CONTAINER" "$AUDIO" "$OUTDEV" "$INDEV"
        printf 'CURSOR=%q\nCOUNTDOWN=%q\nLIMIT=%q\nCOPY_PATH=%q\nOPEN_AFTER=%q\nSAVEDIR=%q\n' \
            "$CURSOR" "$COUNTDOWN" "$LIMIT" "$COPY_PATH" "$OPEN_AFTER" "$SAVEDIR"
    } > "$CONF"
}
cfg_load

# ---------------- 标签 ----------------
lbl_engine()  { if [[ $ENGINE == gsr ]]; then printf 'GPU（gpu-screen-recorder）'; else printf '兼容（wf-recorder）'; fi; }
lbl_audio()   { case $AUDIO in system) printf '系统声音';; mic) printf '麦克风';; both) printf '系统+麦克风';; *) printf '关闭';; esac; }
lbl_res()     { case $RES in source) printf '原始';; *) printf '${RES}p';; esac; }
lbl_onoff()   { if [[ $1 == yes ]]; then printf '开'; else printf '关'; fi; }
lbl_cursor()  { if [[ $CURSOR == yes ]]; then printf '显示'; else printf '隐藏'; fi; }
lbl_limit()   { if (( LIMIT > 0 )); then printf '${LIMIT} 分钟'; else printf '不限'; fi; }
lbl_count()   { if (( COUNTDOWN > 0 )); then printf '${COUNTDOWN} 秒'; else printf '关'; fi; }
summary()     { local e=GPU; [[ $ENGINE == wf ]] && e=兼容; printf '%s · %sfps · %s · %s' "$e" "$FPS" "$CODEC" "$(lbl_audio)"; }

# ---------------- 状态 ----------------
rec_engine() {
    if [[ -f "$PIDF" ]]; then
        local pid; pid=$(cat "$PIDF" 2>/dev/null || true)
        if [[ -n "$pid" ]] && kill -0 "$pid" 2>/dev/null; then
            cat "$ENGF" 2>/dev/null || printf 'gsr'; return 0
        fi
    fi
    if pgrep -x wf-recorder >/dev/null 2>&1; then printf 'wf'; return 0; fi
    if pgrep -f 'gpu-screen-recorder' >/dev/null 2>&1; then printf 'gsr'; return 0; fi
    return 1
}
is_recording() { [[ -n "$(rec_engine)" ]]; }
elapsed_secs() {
    [[ -f "$STARTF" ]] || { printf 0; return; }
    local s; s=$(cat "$STARTF" 2>/dev/null || printf 0)
    [[ "$s" =~ ^[0-9]+$ ]] || { printf 0; return; }
    printf '%d' "$(( $(date +%s) - s ))"
}
fmt_dur() { local s=$1; printf '%02d:%02d:%02d' $((s/3600)) $((s%3600/60)) $((s%60)); }

pick() {
    local prompt="$1"; shift
    (($#)) || return 130
    have fuzzel || die "缺少 fuzzel" "装 fuzzel 后再试"
    local lines=$(( $# > 12 ? 12 : $# ))
    printf '%s\n' "$@" | fuzzel --dmenu --prompt="$prompt " --lines="$lines" --width=46
}

# ---------------- 几何 ----------------
pick_region() { have slurp || return 1; slurp -b 00000000 -c FFFFFFFF -w 2; }

window_region() {
    have niri && have jq || return 1
    niri msg --json focused-window 2>/dev/null | jq -er '
        .layout as $l
        | select($l.tile_pos_in_workspace_view != null)
        | [$l.tile_pos_in_workspace_view[0], $l.tile_pos_in_workspace_view[1],
           $l.window_size[0], $l.window_size[1]] | @tsv' 2>/dev/null | {
            IFS=$'\t' read -r x y w h || exit 1
            [[ "$x" =~ ^-?[0-9]+$ && "$y" =~ ^-?[0-9]+$ ]] || exit 1
            printf '%d,%d %dx%d' "$x" "$y" "$w" "$h"
        }
}

region_scale() {
    have niri && have jq || { printf 1; return; }
    local s; s=$(niri msg --json outputs 2>/dev/null | jq -r '[.[] | .logical.scale] | first // 1' 2>/dev/null || true)
    if [[ "$s" =~ ^[0-9.]+$ ]]; then printf '%s' "$s"; else printf 1; fi
}

to_gsr_region() {
    local geom="$1" scale x y w h
    scale=$(region_scale)
    read -r x y w h <<<"$(sed -E 's/^([-0-9]+),([-0-9]+) ([0-9]+)x([0-9]+)$/\1 \2 \3 \4/' <<<"$geom")"
    awk -v s="$scale" -v x="$x" -v y="$y" -v w="$w" -v h="$h" \
        'BEGIN{printf "%dx%d+%d+%d", int(w*s+0.5), int(h*s+0.5), int(x*s+0.5), int(y*s+0.5)}'
}

# -q 的取值随码率模式变化：qp/vbr 用档位名，cbr 用整数码率（kbps）
quality_arg() {
    if [[ $BITMODE == cbr ]]; then
        case "$CODEC:$QUALITY" in
            h264:medium)   printf '4000'  ;;
            h264:high)     printf '8000'  ;;
            h264:very_high) printf '16000' ;;
            h264:ultra)    printf '30000' ;;
            hevc:medium)   printf '2500'  ;;
            hevc:high)     printf '5000'  ;;
            hevc:very_high) printf '10000' ;;
            hevc:ultra)    printf '20000' ;;
            av1:medium)    printf '2000'  ;;
            av1:high)      printf '4000'  ;;
            av1:very_high) printf '8000'  ;;
            av1:ultra)     printf '16000' ;;
            *)             printf '8000'  ;;
        esac
    else
        printf '%s' "$QUALITY"
    fi
}

res_size() {
    case $RES in
        2160) printf '3840x2160' ;;
        1080) printf '1920x1080' ;;
        720)  printf '1280x720' ;;
        *)    printf '0x0' ;;
    esac
}

list_audio_devices() {
    if have gpu-screen-recorder; then
        gpu-screen-recorder --list-audio-devices 2>/dev/null | awk -F'|' 'NF>=2 {print $1" — "$2}'
    elif have pactl; then
        pactl list short sources 2>/dev/null | awk '{print $2" — "$2}'
    fi
}

dev_label() {
    local id="$1" line
    line=$(list_audio_devices | grep -m1 -- "^$id — " || true)
    if [[ -n "$line" ]]; then printf '%s' "${line#* — }"; else printf '%s' "$id"; fi
}

# ---------------- 录制 ----------------
start_rec() {
    local mode="${1:-fullscreen}"
    if is_recording; then
        notify "已经在录制了" "先停止当前录制（$(fmt_dur "$(elapsed_secs)")）"
        return 0
    fi

    local geom=""
    case "$mode" in
        fullscreen) ;;
        region)
            geom=$(pick_region) || { notify "已取消" "没有选区"; return 0; }
            [[ -n "$geom" ]] || return 0
            ;;
        window)
            if ! geom=$(window_region); then
                local ans
                ans=$(pick "这个窗口拿不到屏幕坐标" "改用区域框选" "取消") || return 0
                [[ "$ans" == 改用* ]] || return 0
                mode=region
                geom=$(pick_region) || return 0
                [[ -n "$geom" ]] || return 0
            fi
            ;;
        *) die "未知模式：$mode" ;;
    esac

    if (( COUNTDOWN > 0 )); then
        local i
        for ((i=COUNTDOWN; i>0; i--)); do notify "倒计时 $i" "马上开始录制"; sleep 1; done
    fi

    local stamp out
    stamp=$(date +%Y%m%d-%H%M%S)
    out="$SAVEDIR/rec-$stamp-$mode.$CONTAINER"
    local engine="$ENGINE"
    if [[ $engine == gsr ]] && ! have gpu-screen-recorder; then engine=wf; fi
    if [[ $engine == wf  ]] && ! have wf-recorder;        then engine=gsr; fi
    have gpu-screen-recorder || have wf-recorder || die "没有可用的录屏引擎" "装 gpu-screen-recorder 或 wf-recorder"

    local -a args
    if [[ $engine == gsr ]]; then
        args=(gpu-screen-recorder -f "$FPS" -c "$CONTAINER" -o "$out"
              -k "$CODEC" -q "$(quality_arg)" -bm "$BITMODE" -cursor "$CURSOR")
        [[ $RES != source ]] && args+=(-s "$(res_size)")
        case "$mode" in
            fullscreen) args+=(-w screen) ;;
            *)          args+=(-w region -region "$(to_gsr_region "$geom")") ;;
        esac
        case $AUDIO in
            system) args+=(-a "$OUTDEV") ;;
            mic)    args+=(-a "$INDEV") ;;
            both)   args+=(-a "$OUTDEV|$INDEV") ;;
        esac
    else
        local codec=libx264 crf=20
        case $CODEC in
            hevc) codec=libx265 ;;
            av1)  codec=libsvtav1 ;;
        esac
        case $QUALITY in
            ultra) crf=18 ;; very_high) crf=20 ;; high) crf=23 ;; *) crf=28 ;;
        esac
        args=(wf-recorder -f "$out" -r "$FPS" -c "$codec" -p "crf=$crf")
        case "$mode" in
            region|window) args+=(-g "$geom") ;;
        esac
        case $AUDIO in
            system) args+=(-a="$OUTDEV") ;;
            mic)    args+=(-a="$INDEV") ;;
            both)   args+=(-a="$OUTDEV") ;;
        esac
    fi

    setsid "${args[@]}" >"$LOG" 2>&1 </dev/null &
    local pid=$!
    printf '%s' "$pid" >"$PIDF"
    printf '%s' "$engine" >"$ENGF"
    printf '%s' "$mode" >"$MODEF"
    printf '%s' "$out" >"$OUTF"
    date +%s >"$STARTF"

    if (( LIMIT > 0 )); then
        ( sleep $(( LIMIT * 60 )); kill -INT "$pid" 2>/dev/null || true ) >/dev/null 2>&1 &
        printf '%s' "$!" >"$WATCHF"
    fi

    sleep 0.8
    if ! kill -0 "$pid" 2>/dev/null; then
        local err; err=$(tail -3 "$LOG" 2>/dev/null | tr '\n' ' ')
        notify "录制没能启动" "${err:-看 $LOG}"
        rm -f "$out" "$PIDF" "$STARTF" "$WATCHF"
        return 1
    fi
    notify "开始录制（$engine · $mode）" "$(basename "$out")，再按 Alt+F6 停止"
}

stop_rec() {
    if ! is_recording; then notify "没在录" ""; return 0; fi
    local pid="" out=""
    if [[ -f "$WATCHF" ]]; then kill "$(cat "$WATCHF" 2>/dev/null)" 2>/dev/null || true; rm -f "$WATCHF"; fi
    [[ -f "$PIDF" ]] && pid=$(cat "$PIDF" 2>/dev/null || true)
    [[ -f "$OUTF" ]] && out=$(cat "$OUTF" 2>/dev/null || true)
    local dur; dur=$(fmt_dur "$(elapsed_secs)")

    if [[ -n "$pid" ]] && kill -0 "$pid" 2>/dev/null; then
        kill -INT "$pid" 2>/dev/null || true
        local i
        for i in $(seq 1 40); do kill -0 "$pid" 2>/dev/null || break; sleep 0.1; done
        if kill -0 "$pid" 2>/dev/null; then kill -TERM "$pid" 2>/dev/null || true; fi
    else
        pkill -INT -x wf-recorder 2>/dev/null || true
        pkill -INT -f gpu-screen-recorder 2>/dev/null || true
    fi

    sleep 0.5
    local size=""
    if [[ -n "$out" && -f "$out" ]]; then size=$(du -h "$out" 2>/dev/null | cut -f1); fi

    if [[ -n "$out" && -f "$out" ]]; then
        if [[ $COPY_PATH == yes ]] && have wl-copy; then printf '%s' "$out" | wl-copy 2>/dev/null || true; fi
        if [[ $COPY_PATH == yes ]]; then
            notify "录制完成 · $dur · ${size:-?}" "$(basename "$out")（路径已复制）"
        else
            notify "录制完成 · $dur · ${size:-?}" "$(basename "$out")"
        fi
        if [[ $OPEN_AFTER == yes ]]; then xdg-open "$SAVEDIR" >/dev/null 2>&1 || true; fi
    else
        notify "录制结束，但没找到文件" "$LOG"
    fi
    rm -f "$PIDF" "$STARTF" "$ENGF" "$MODEF" "$OUTF"
}

# ---------------- 设置 ----------------
menu_quality() {
    local c
    while :; do
        c=$(pick "画质（$CODEC · $QUALITY · ${FPS}fps）" \
            "编码：$CODEC" "质量档：$QUALITY" "码率模式：$BITMODE" \
            "帧率：${FPS} fps" "分辨率上限：$(lbl_res)" "返回") || return 0
        case "$c" in
            "编码："*)
                c=$(pick "编码" h264 hevc av1 hevc_10bit av1_10bit) || continue
                CODEC="$c" ;;
            "质量档："*)
                c=$(pick "质量档（qp/vbr 模式）" medium high very_high ultra) || continue
                QUALITY="$c" ;;
            "码率模式："*)
                c=$(pick "码率模式" qp vbr cbr) || continue
                BITMODE="$c" ;;
            "帧率："*)
                c=$(pick "帧率" "30 fps" "60 fps" "120 fps" "144 fps") || continue
                FPS="${c%% *}" ;;
            "分辨率上限："*)
                c=$(pick "分辨率上限（GPU 引擎生效）" "原始" "1080p" "720p" "2160p") || continue
                case "$c" in 原始) RES=source ;; 1080p) RES=1080 ;; 720p) RES=720 ;; 2160p) RES=2160 ;; esac ;;
            *) return 0 ;;
        esac
        cfg_save
    done
}

menu_audio() {
    local c dev
    while :; do
        c=$(pick "声音（$(lbl_audio)）" \
            "音频源：$(lbl_audio)" \
            "输出设备：$(dev_label "$OUTDEV")" \
            "输入设备：$(dev_label "$INDEV")" \
            "返回") || return 0
        case "$c" in
            "音频源："*)
                c=$(pick "音频源" "关闭" "系统声音" "麦克风" "系统+麦克风") || continue
                case "$c" in 关闭) AUDIO=off ;; 系统声音) AUDIO=system ;; 麦克风) AUDIO=mic ;; *) AUDIO=both ;; esac ;;
            "输出设备："*)
                # shellcheck disable=SC2046
                c=$(pick "输出设备（系统声音）" "default_output — 默认输出" $(list_audio_devices)) || continue
                dev="${c%% — *}"; OUTDEV="$dev" ;;
            "输入设备："*)
                # shellcheck disable=SC2046
                c=$(pick "输入设备（麦克风）" "default_input — 默认输入" $(list_audio_devices)) || continue
                dev="${c%% — *}"; INDEV="$dev" ;;
            *) return 0 ;;
        esac
        cfg_save
    done
}

menu_files() {
    local c
    while :; do
        c=$(pick "文件（$CONTAINER）" \
            "容器：$CONTAINER" \
            "保存目录：$SAVEDIR" \
            "停止后复制路径：$(lbl_onoff "$COPY_PATH")" \
            "停止后打开目录：$(lbl_onoff "$OPEN_AFTER")" \
            "返回") || return 0
        case "$c" in
            "容器："*)
                c=$(pick "容器格式" mp4 mkv webm) || continue
                CONTAINER="$c" ;;
            "保存目录："*)
                c=$(pick "选择目录（Esc 取消）" "$SAVEDIR" "$HOME/Videos" "$HOME/Videos/录屏" "$HOME/桌面") || continue
                c="${c/#\~/$HOME}"
                if mkdir -p "$c" 2>/dev/null; then SAVEDIR="$c"; else notify "目录不可用" "$c"; fi ;;
            "停止后复制路径："*)
                if [[ $COPY_PATH == yes ]]; then COPY_PATH=no; else COPY_PATH=yes; fi ;;
            "停止后打开目录："*)
                if [[ $OPEN_AFTER == yes ]]; then OPEN_AFTER=no; else OPEN_AFTER=yes; fi ;;
            *) return 0 ;;
        esac
        cfg_save
    done
}

menu_behavior() {
    local c
    while :; do
        c=$(pick "行为（光标 $(lbl_cursor) · 倒计时 $(lbl_count) · 上限 $(lbl_limit)）" \
            "光标：$(lbl_cursor)" \
            "倒计时：$(lbl_count)" \
            "时长上限：$(lbl_limit)" \
            "返回") || return 0
        case "$c" in
            "光标："*)
                if [[ $CURSOR == yes ]]; then CURSOR=no; else CURSOR=yes; fi ;;
            "倒计时："*)
                c=$(pick "倒计时" "关" "3 秒" "5 秒") || continue
                case "$c" in 关) COUNTDOWN=0 ;; 3*) COUNTDOWN=3 ;; 5*) COUNTDOWN=5 ;; esac ;;
            "时长上限："*)
                c=$(pick "自动停止（分钟）" "不限" "5" "15" "30" "60") || continue
                if [[ "$c" == 不限 ]]; then LIMIT=0; else LIMIT="$c"; fi ;;
            *) return 0 ;;
        esac
        cfg_save
    done
}

menu_settings() {
    local c
    while :; do
        c=$(pick "设置（$(summary)）" \
            "画质（编码/质量/码率/帧率/分辨率）…" \
            "声音（音频源/设备）…" \
            "文件（容器/目录/收尾动作）…" \
            "行为（光标/倒计时/上限）…" \
            "全部恢复默认" \
            "返回") || return 0
        case "$c" in
            "画质"*)  menu_quality ;;
            "声音"*)  menu_audio ;;
            "文件"*)  menu_files ;;
            "行为"*)  menu_behavior ;;
            "全部恢复默认")
                c=$(pick "确认恢复默认设置？" "确定" "取消") || continue
                if [[ "$c" == 确定 ]]; then cfg_defaults; cfg_save; notify "已恢复默认" ""; fi ;;
            *) return 0 ;;
        esac
    done
}

show_menu() {
    local head=()
    if is_recording; then head=("■ 停止录制 · $(fmt_dur "$(elapsed_secs)")"); fi
    local c
    if (( ${#head[@]} > 0 )); then
        c=$(pick "录屏" "${head[@]}" \
            "▶ 全屏录制" "▶ 区域录制（框选）" "▶ 窗口录制（当前焦点）" \
            "设置…（$(summary)）" "打开录像目录" "退出") || return 0
    else
        c=$(pick "录屏" \
            "▶ 全屏录制" "▶ 区域录制（框选）" "▶ 窗口录制（当前焦点）" \
            "设置…（$(summary)）" "打开录像目录" "退出") || return 0
    fi
    case "$c" in
        "■ 停止录制"*) stop_rec ;;
        "▶ 全屏"*)      start_rec fullscreen ;;
        "▶ 区域"*)      start_rec region ;;
        "▶ 窗口"*)      start_rec window ;;
        "设置…"*)       menu_settings; show_menu ;;
        "打开录像目录")
            if have xdg-open; then xdg-open "$SAVEDIR" >/dev/null 2>&1 || true; else notify "录像目录" "$SAVEDIR"; fi ;;
        *) return 0 ;;
    esac
}

case "${1:-}" in
    ""|-m|--menu) show_menu ;;
    --start)      start_rec "${2:-fullscreen}" ;;
    --stop)       stop_rec ;;
    --toggle)     if is_recording; then stop_rec; else start_rec fullscreen; fi ;;
    --settings)   menu_settings ;;
    --status)
        if is_recording; then
            printf 'recording %s %s %s\n' "$(elapsed_secs)" "$(rec_engine)" "$(cat "$OUTF" 2>/dev/null || true)"
        else
            printf 'idle\n'
        fi
        ;;
    -h|--help) sed -n '2,20p' "$0" | sed 's/^# \{0,1\}//' ;;
    *) printf '未知参数：%s（用 --help）\n' "$1" >&2; exit 2 ;;
esac
