    # shellcheck source=/dev/null
    source "$SCRIPT_DIR/lib/pac-ai.sh"
fi
NO_AI=false
CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/pac/pacr"
REPO_CACHE="${CACHE_DIR}/repo_packages.txt"

