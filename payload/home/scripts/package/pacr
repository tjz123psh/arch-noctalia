    .local/share/Trash .local/share/keyrings .local/share/flatpak .local/share/mime .local/share/icons .local/share/fonts
    .local/share/themes .local/share/applications .local/share/systemd .local/share/gvfs-metadata .local/share/pacman
    .local/state/wireplumber .local/bin .local/lib .themes .icons .fonts .var/app .var .local .config .cache
    Desktop Documents Downloads Music Pictures Videos Public Templates
)

# 这些共享目录整体不列，但允许列出它们内部的单个文件（应用专属条目）
DENYLIST_ALLOW_INSIDE=".local/share/applications .config .cache .local .var .var/app Desktop Documents Downloads Music Pictures Videos"

# 通用词：不能作为匹配关键词
GENERIC_TOKENS=" linux arch tool tools client app apps desktop the and for with gnu gtk qt git bin lib libs x86 wine proton official unofficial free open source software program launcher manager viewer player editor plugin plugins theme themes icon icons font font data config cache share local state common core base extra community utils util python python3 nodejs node java rust "

is_denied() {
    # is_denied <绝对路径>：命中豁免名单或不在家目录内 → 返回 0
    local path="$1" rel entry allow a
    case "$path" in
        "$HOME"/*) rel="${path#"$HOME"/}" ;;
        *) return 0 ;;
    esac
    [[ -n "$rel" ]] || return 0
    for entry in "${DENYLIST[@]}"; do
        if [[ "$rel" == "$entry" || "$rel" == "$entry"/* ]]; then
            allow=false
            for a in $DENYLIST_ALLOW_INSIDE; do
                [[ "$entry" == "$a" ]] && allow=true
            done
            if [[ "$allow" == true && "$rel" != "$entry" ]]; then
                continue
            fi
            return 0
        fi
    done
    return 1
}

# ==============================================================================
# 7. 包元数据 → 匹配关键词
# ==============================================================================
# 关键词分两档：
#   strong —— 包名、二进制名、desktop 名、URL 段：允许"包含"匹配
#   weak   —— 从名字里拆出来的通用片段（kimi-code-bin 里的 code）：只认整名相同
# 分档的原因是真机测试踩到的：靠"包含"匹配时，code 会命中 ~/.config/opencode、
# ~/Projects/punycode.js、leetcode……几十条噪音，误删风险很大。
add_token() {
    local t existing kind="${2:-strong}" kept=()
    t=$(printf '%s' "$1" | tr '[:upper:]' '[:lower:]' | tr -d '"' | sed 's/^[[:space:]]*//; s/[[:space:]]*$//')
    (( ${#t} >= 2 )) || return 0
    [[ "$GENERIC_TOKENS" != *" $t "* ]] || return 0
    [[ "$t" =~ ^[a-z0-9][a-z0-9._+-]*$ ]] || return 0

    if [[ "$kind" == "weak" ]]; then
        # 已经是强关键词就不再降级
        for existing in "${TOKENS[@]:-}"; do
            [[ "$existing" != "$t" ]] || return 0
        done
        for existing in "${WEAK_TOKENS[@]:-}"; do
            [[ "$existing" != "$t" ]] || return 0
        done
        WEAK_TOKENS+=("$t")
        return 0
    fi

    # 强关键词：若此前作为拆分片段进过弱名单，要升级上来
    # （kimi-code-bin 会先拆出 kimi 这个片段，之后二进制名 kimi 必须把它升级成强关键词，
    #   否则 ~/.kimi 这种目录名就对不上了）
    for existing in "${WEAK_TOKENS[@]:-}"; do
        [[ -n "$existing" && "$existing" != "$t" ]] && kept+=("$existing")
    done
    WEAK_TOKENS=()
    (( ${#kept[@]} > 0 )) && WEAK_TOKENS=("${kept[@]}")

    for existing in "${TOKENS[@]:-}"; do
        [[ "$existing" != "$t" ]] || return 0
    done
    TOKENS+=("$t")
}

add_name_tokens() {
    local name="$1" base part
    add_token "$name"
    base=$(printf '%s' "$name" | sed -E 's/-(git|bin|appimage|electron|wayland|qt|gtk|nightly|beta|dev|stable|desktop|app|cli|gui)$//; s/^linux//')
    add_token "$base"
    for part in $(printf '%s' "$name" | tr '._-' '   '); do
        add_token "$part" weak
    done
}

collect_pacman_meta() {
    # 必须在卸载前调用：pacman -Qi / -Qlq 在包被删掉后就查不到了
    local pkg="$1" desc url line dname wm seg
    local -a bins=()
    desc=$(pacman -Qi "$pkg" 2>/dev/null | awk '/^(Description|描述)/ { sub(/^[^:]*:[ \t]*/, ""); print; exit }')
    url=$(pacman -Qi "$pkg" 2>/dev/null | awk '/^(URL|网址)/ { sub(/^[^:]*:[ \t]*/, ""); print; exit }')
    add_name_tokens "$pkg"
    while IFS= read -r line; do
        case "$line" in
            /usr/bin/*)
                [[ "$line" == */ ]] && continue
                bins+=("$(basename "$line")")
                add_name_tokens "$(basename "$line")"
                ;;
            /usr/share/applications/*.desktop)
                dname=$(grep -m1 -E '^Name=' "$line" 2>/dev/null | cut -d= -f2- || true)
                wm=$(grep -m1 -E '^StartupWMClass=' "$line" 2>/dev/null | cut -d= -f2- || true)
                add_name_tokens "$(basename "$line" .desktop)"
                [[ -z "$dname" ]] || add_name_tokens "$dname"
                [[ -z "$wm" ]] || add_name_tokens "$wm"
                ;;
        esac
    done < <(pacman -Qlq "$pkg" 2>/dev/null || true)
    if [[ -n "$url" ]]; then
        local host path sld
        host=$(printf '%s' "$url" | sed -E 's#^[a-zA-Z]+://##; s#[/:?].*##; s#^www\.##')
        path=$(printf '%s' "$url" | sed -E 's#^[a-zA-Z]+://[^/]+##')
        case "$host" in
            github.com|gitlab.com|codeberg.org|sourceforge.net|gitee.com|bitbucket.org|*.github.io|*.gitlab.io) ;;
            *)
                local -a labels=()
                IFS='.' read -r -a labels <<< "$host"
                if (( ${#labels[@]} >= 2 )); then
                    sld="${labels[$(( ${#labels[@]} - 2 ))]}"
                    case "$sld" in
                        co|com|org|net|ac|edu|gov) (( ${#labels[@]} >= 3 )) && sld="${labels[$(( ${#labels[@]} - 3 ))]}" ;;
                    esac
                    add_token "$sld"
                fi
                ;;
        esac
        for seg in $(printf '%s' "$path" | tr '/' ' '); do add_name_tokens "$seg"; done
    fi
    # 描述里的大写词只是猜测（"Kimi Code CLI" 里的 Code 是通用词），归弱档：
    # 只参与"整名相同"，不会把 ~/Projects/punycode.js 这类东西扫进来
    for seg in $(printf '%s' "$desc" | tr -c 'A-Za-z0-9' ' '); do
        [[ "$seg" =~ ^[A-Z][A-Za-z0-9]{3,}$ ]] && add_token "$seg" weak
    done
    jq -cn --arg name "$pkg" --arg desc "$desc" --arg url "$url" \
        --argjson bins "$(printf '%s\n' "${bins[@]:-}" | grep -v '^$' | jq -R . | jq -s .)" \
        '{name:$name, kind:"pacman", description:$desc, url:$url, binaries:$bins}' >> "$PKG_META_FILE"
}

collect_flatpak_meta() {
    local appid="$1" name part
    name=$(flatpak info "$appid" 2>/dev/null | awk '/^(Name|名称)/ { sub(/^[^:]*:[ \t]*/, ""); print; exit }' || true)
    add_token "$appid"
    for part in $(printf '%s' "$appid" | tr '.' ' '); do
        case "$part" in com|org|io|net|de|fr|uk|cn|app|github|gitlab|codeberg|sourceforge) ;; *) add_name_tokens "$part" ;; esac
    done
    [[ -z "$name" ]] || add_name_tokens "$name"
    jq -cn --arg name "$appid" --arg desc "$name" \
        '{name:$name, kind:"flatpak", description:$desc, url:"", binaries:[],
          data_dir:("~/.var/app/" + $name)}' >> "$PKG_META_FILE"
}

collect_metadata() {
    local p
    : > "$PKG_META_FILE"
    TOKENS=()
    WEAK_TOKENS=()
    printf '\n\033[36m%s\033[0m\n' "${MSG[COLLECTING]}"
    for p in "${PAC_PKGS[@]:-}"; do [[ -n "$p" ]] && collect_pacman_meta "$p"; done
    for p in "${FPK_PKGS[@]:-}"; do [[ -n "$p" ]] && collect_flatpak_meta "$p"; done
    printf '   \033[90m%s %s\033[0m\n' "${MSG[TOKENS]}" "${TOKENS[*]:-}"
}

# ==============================================================================
# 8. 家目录候选枚举（移植自 shorin-pac）
# ==============================================================================
path_matches_tokens() {
    local base t matched=""
    base=$(basename "$1" | tr '[:upper:]' '[:lower:]')
    base="${base%.desktop}"
    for t in "${TOKENS[@]:-}"; do
        [[ -n "$t" ]] || continue
        if [[ "$base" == "$t" ]]; then
            matched="${matched:+$matched }$t"
        elif (( ${#t} >= 3 )) && { [[ "$base" == *"$t"* ]] || { (( ${#base} >= 4 )) && [[ "$t" == *"$base"* ]]; }; }; then
            matched="${matched:+$matched }$t"
        fi
    done
    # 弱关键词只认整名相同
    for t in "${WEAK_TOKENS[@]:-}"; do
        [[ -n "$t" ]] || continue
        [[ "$base" == "$t" ]] && matched="${matched:+$matched }$t"
    done
    [[ -n "$matched" ]] || return 1
    printf '%s' "$matched"
}

emit_candidate() {
    # emit_candidate <路径> <位置> <匹配词> <来源>：去重、豁免名单、存在性校验后写一行
    local path="$1" loc="$2" matched="$3" src="$4" bytes
    [[ -e "$path" && ! -L "$path" ]] || return 0
    is_denied "$path" && return 0
    grep -qxF -- "$path" "$SEEN_FILE" 2>/dev/null && return 0
    printf '%s\n' "$path" >> "$SEEN_FILE"
    bytes=$(du -sb -- "$path" 2>/dev/null | cut -f1 || echo 0)
    printf '%s\t%s\t%s\t%s\t%s\n' "$path" "$loc" "${bytes:-0}" "$matched" "$src" >> "$CAND_FILE"
}

enumerate_candidates() {
    # 标准位置按"每个应用一个条目"枚举，再对可见目录做限深关键词搜索
    local root entry matched name
    for root in .config .cache .local/share .local/state .var/app; do
        [[ -d "$HOME/$root" ]] || continue
        for entry in "$HOME/$root"/* "$HOME/$root"/.[!.]*; do
            [[ -e "$entry" ]] || continue
            if matched=$(path_matches_tokens "$entry"); then
                emit_candidate "$entry" "$root" "$matched" "name"
            fi
        done
    done

    # 共享目录里的单个文件（应用专属条目）
    for root in .local/share/applications .config/autostart .local/share/pixmaps; do
        [[ -d "$HOME/$root" ]] || continue
        while IFS= read -r entry; do
            if matched=$(path_matches_tokens "$entry"); then
                emit_candidate "$entry" "$root" "$matched" "name"
            fi
        done < <(find "$HOME/$root" -maxdepth 3 -type f 2>/dev/null)
    done

    # 根级点目录/点文件
    for entry in "$HOME"/.[!.]*; do
        [[ -e "$entry" ]] || continue
        name=$(basename "$entry")
        case "$name" in .config|.cache|.local|.var) continue ;; esac
        if matched=$(path_matches_tokens "$entry"); then
            emit_candidate "$entry" "home" "$matched" "name"
        fi
    done

    # 可见目录限深搜索：覆盖 ~/Documents/Tencent Files 这类偏门位置
    local -a find_args=()
    local t
    for t in "${TOKENS[@]:-}"; do
        [[ -n "$t" ]] || continue
        if (( ${#t} >= 3 )); then find_args+=(-o -iname "*${t}*"); else find_args+=(-o -iname "$t"); fi
    done
    # 弱关键词只按整名搜索，避免 code 把 ~/Projects 里一堆带 code 的文件扫进来
    for t in "${WEAK_TOKENS[@]:-}"; do
        [[ -n "$t" ]] || continue
        find_args+=(-o -iname "$t")
    done
    (( ${#find_args[@]} > 0 )) || return 0
    while IFS= read -r entry; do
        if matched=$(path_matches_tokens "$entry"); then
            emit_candidate "$entry" "visible" "$matched" "name"
        fi
    done < <(find "$HOME" -mindepth 2 -maxdepth "$MAX_TOKEN_SEARCH_DEPTH" -not -path "$HOME/.*" \
                \( -false "${find_args[@]}" \) 2>/dev/null | head -n 200)
}

score_and_sort() {
    # 追踪到的路径优先级最高；名字完全同名的次之；再按所在位置加权
    {
        for t in "${TOKENS[@]:-}"; do [[ -n "$t" ]] && printf 'strong\t%s\n' "$t"; done
        for t in "${WEAK_TOKENS[@]:-}"; do [[ -n "$t" ]] && printf 'weak\t%s\n' "$t"; done
    } > "$TOKENS_FILE"
    awk -F '\t' -v toks_file="$TOKENS_FILE" \
        -v r_trace="${MSG[REASON_TRACE]}" -v r_exact="${MSG[REASON_EXACT]}" -v r_match="${MSG[REASON_MATCH]}" '
        BEGIN {
            while ((getline line < toks_file) > 0) {
                split(line, f, "\t")
                if (f[1] == "strong") strong[f[2]] = 1
                else if (f[1] == "weak") weak[f[2]] = 1
            }
        }
        {
            path = $1; loc = $2; bytes = $3; matched = $4; src = $5
            n = split(path, parts, "/"); base = tolower(parts[n]); sub(/\.desktop$/, "", base)
            score = (src == "trace") ? 200 : 0
            if (base in strong) score += 100
            else if (base in weak) score += 40
            if (loc == ".config" || loc == ".local/share" || loc == ".var/app") score += 20
            else if (loc == ".cache" || loc == ".local/state") score += 10
            else if (loc == "home") score += 5
            conf = (src == "trace") ? "high" : ((base in strong) ? "medium" : "low")
            reason = (src == "trace") ? r_trace : ((base in strong) ? r_exact : (r_match ": " matched))
            printf "%d\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n", score, src, bytes, path, matched, loc, conf, reason
        }
    ' "$CAND_FILE" | sort -rn -k1,1 | head -n "$MAX_CANDIDATES" > "${CAND_FILE}.sorted"
    mv -f "${CAND_FILE}.sorted" "$CAND_FILE"

    # 去掉被父目录覆盖的子项（父项在清单里时，子项不再单列）
    awk -F '\t' '
        { lines[NR] = $0 }
        END {
            for (i = 1; i <= NR; i++) {
                split(lines[i], a, "\t"); p = a[4]; covered = 0
                for (j = 1; j <= NR; j++) {
                    if (i == j) continue
                    split(lines[j], b, "\t"); q = b[4]
                    if (index(p, q "/") == 1) { covered = 1; break }
                }
                if (!covered) print lines[i]
            }
        }
    ' "$CAND_FILE" > "$FINAL_FILE"
}

ai_refine_leftovers() {
    # 把候选交给模型判置信度。模型给的路径同样要过存在性、家目录、豁免名单三关。
    local dossier result

    [[ "$NO_AI" == true ]] && return 0
    declare -F ai_chat >/dev/null 2>&1 || return 0
    [[ -s "$FINAL_FILE" ]] || return 0

    if ! ai_config_load; then
        printf '   \033[90m%s\033[0m\n' "${MSG[AI_SKIP]}"
        return 0
    fi
    if [[ -z "$LEFTOVER_PROMPT" ]]; then
        printf '   \033[33m%s\033[0m\n' "${MSG[AI_FAILED]}"
        return 0
    fi

    dossier="$TMP_DIR/leftover.dossier.json"
    result="$TMP_DIR/leftover.result.json"

    jq -n --arg home "$HOME" \
        --slurpfile pkgs "$PKG_META_FILE" \
        --rawfile cands "$FINAL_FILE" \
        --argjson tokens "$(printf '%s\n' "${TOKENS[@]:-}" "${WEAK_TOKENS[@]:-}" | grep -v '^$' | jq -R . | jq -s .)" \
        '{
           home: $home,
           tokens: $tokens,
           packages: ($pkgs[0] // []),
           candidates: (
             $cands | split("\n") | map(select(length > 0))
             | map(split("\t") | {score: (.[0]|tonumber?), src: .[1], bytes: (.[2]|tonumber?),
                                    path: .[3], matched: .[4], location: .[5]})
           )
         }' > "$dossier"

    printf '   \033[36m%s\033[0m \033[90m%s @ %s\033[0m\n' "${MSG[AI_JUDGE]}" "$AI_MODEL" "$(ai_host)"
    if ! ai_chat "$LEFTOVER_PROMPT" "$dossier" "$result"; then
        printf '   \033[33m%s\033[0m\n' "${MSG[AI_FAILED]}"
        return 0
    fi
    apply_ai_leftovers "$result"
}

apply_ai_leftovers() {
    local result="$1" line path conf reason bytes

    if ! jq -e '.leftovers | type == "array"' "$result" >/dev/null 2>&1; then
        printf '   \033[33m%s\033[0m\n' "${MSG[AI_FAILED]}"
        return 0
    fi

    while IFS= read -r line; do
        [[ -n "$line" ]] || continue
        path="$(jq -r '.path // empty' <<< "$line" 2>/dev/null)"
        [[ -n "$path" ]] || continue

        path="${path/#\~/$HOME}"
        [[ "$path" == /* ]] || path="$HOME/$path"
        path="$(realpath -m -- "$path" 2>/dev/null || printf '%s' "$path")"

        [[ -e "$path" && ! -L "$path" ]] || continue
        is_denied "$path" && continue

        conf="$(jq -r '.confidence // "low"' <<< "$line" 2>/dev/null)"
        reason="$(jq -r '.reason // ""' <<< "$line" 2>/dev/null | tr -d '\t\n')"

        if awk -F '\t' -v p="$path" '$4 == p { found = 1 } END { exit !found }' "$FINAL_FILE"; then
            awk -F '\t' -v p="$path" -v c="$conf" -v r="$reason" 'BEGIN { OFS = "\t" }
                { if ($4 == p) { $7 = c; $8 = r } print }' "$FINAL_FILE" > "${FINAL_FILE}.tmp"
            mv -f -- "${FINAL_FILE}.tmp" "$FINAL_FILE"
        else
            bytes="$(du -sb -- "$path" 2>/dev/null | cut -f1 || printf 0)"
            printf '150\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "ai" "${bytes:-0}" "$path" "-" "ai" "$conf" "$reason" >> "$FINAL_FILE"
        fi
    done < <(jq -c '.leftovers[]?' "$result" 2>/dev/null)

    sort -rn -k1,1 "${FINAL_FILE}" -o "$FINAL_FILE" 2>/dev/null || true
}

scan_leftovers() {
    : > "$CAND_FILE"; : > "$SEEN_FILE"; : > "$FINAL_FILE"
    enumerate_candidates
    local p
    for p in "${FPK_PKGS[@]:-}"; do
        [[ -n "$p" ]] && emit_candidate "$HOME/.var/app/$p" ".var/app" "$p" "name"
    done
    for p in "${TRACED_PATHS[@]:-}"; do
        [[ -n "$p" ]] && emit_candidate "$p" "trace" "-" "trace"
    done
    score_and_sort
    ai_refine_leftovers
    printf '   \033[90m%s\033[0m %s\n' "${MSG[CAND_COUNT]}" "$(grep -c . "$FINAL_FILE" 2>/dev/null || echo 0)"
}

human_size() {
    numfmt --to=iec --suffix=B "$1" 2>/dev/null || printf '%sB' "$1"
}

# 把家目录前缀缩写成 ~（注意：这个 bash 里 "${x/#$HOME/~}" 的锚定形式对含斜杠的
# pattern 不生效，所以统一走这个函数，用验证可用的前缀删除形式）
short_path() {
    local p="$1"
    if [[ "$p" == "$HOME"/* ]]; then
        # shellcheck disable=SC2088  # 这里的 ~ 是要打印的字面量
        printf '~/%s' "${p#"$HOME"/}"
    else
        printf '%s' "$p"
    fi
}

print_candidates() {
    local score src bytes path matched loc conf reason src_label conf_label color

    if [[ ! -s "$FINAL_FILE" ]]; then
        printf '   \033[33m%s\033[0m\n' "${MSG[NO_CANDIDATES]}"
        return 0
    fi
    printf '\n\033[36m%s\033[0m\n' "${MSG[SCAN_HEADER]}"
    # shellcheck disable=SC2034  # score 只用来排序，展示时用不到
    while IFS=$'\t' read -r score src bytes path matched loc conf reason; do
        [[ -n "$path" ]] || continue
        case "$src" in
            trace) src_label="${MSG[SRC_TRACE]}"; color=$'\033[32m' ;;
            ai)    src_label="${MSG[SRC_AI]}";    color=$'\033[36m' ;;
            *)     src_label="${MSG[SRC_NAME]}";  color=$'\033[90m' ;;
        esac
        case "$conf" in
            high)   conf_label="${MSG[CONF_HIGH]}" ;;
            medium) conf_label="${MSG[CONF_MED]}" ;;
            *)      conf_label="${MSG[CONF_LOW]}" ;;
        esac
        printf '   %s[%s · %s]\033[0m %-8s %s  \033[90m%s\033[0m\n' \
            "$color" "$src_label" "$conf_label" "$(human_size "$bytes")" "$(short_path "$path")" "$reason"
    done < "$FINAL_FILE"
}

pick_leftovers() {
    local rows="" preselect="" n=0 score src bytes path matched loc conf reason label src_label color
    : > "$PICK_FILE"
    # shellcheck disable=SC2034  # score 只用来排序，展示时用不到
    while IFS=$'\t' read -r score src bytes path matched loc conf reason; do
        [[ -n "$path" ]] || continue
        n=$((n + 1))
        case "$src" in
            trace) src_label="${MSG[SRC_TRACE]}"; color=$'\033[32m' ;;
            ai)    src_label="${MSG[SRC_AI]}";    color=$'\033[36m' ;;
            *)     src_label="${MSG[SRC_NAME]}";  color=$'\033[90m' ;;
        esac
        case "$conf" in
            high)   label="${MSG[CONF_HIGH]}" ;;
            medium) label="${MSG[CONF_MED]}" ;;
            *)      label="${MSG[CONF_LOW]}" ;;
        esac
        # 高置信度（追踪到的、或名字完全同名的、或 AI 判高的）默认预选，其余靠用户自己勾
        if [[ "$conf" == "high" ]]; then
            preselect="${preselect}+pos(${n})+select"
        fi
        rows+="$(printf '%s\t%s[%s · %s]\033[0m %-8s %s  \033[90m%s · %s\033[0m\n' \
            "$path" "$color" "$src_label" "$label" "$(human_size "$bytes")" "$(short_path "$path")" "$reason" "$matched")"$'\n'
    done < "$FINAL_FILE"

    local bind="start:first"
    [[ -z "$preselect" ]] || bind="start:${preselect#+}+first"

    printf '%s' "$rows" | fzf --multi --ansi --delimiter='\t' --with-nth=2.. \
        --height=70% --layout=reverse --border --tiebreak=index \
        --header "${MSG[PICK_HEADER]}" --prompt "${MSG[PICK_PROMPT]}" \
        --bind "$bind" \
        --preview 'p=$(printf "%s" {1}); if [ -d "$p" ]; then ls -la --color=always -- "$p" | head -60; else head -c 2000 -- "$p"; fi' \
        --preview-window=down:45%:wrap \
        | cut -f1 > "$PICK_FILE" || true
}

delete_picked() {
    local path shown ok=0 fail=0
    [[ -s "$PICK_FILE" ]] || return 0
    printf '\n\033[36m%s\033[0m\n' "${MSG[DELETING_HEADER]}"
    while IFS= read -r path; do
        [[ -n "$path" ]] || continue
        shown="$(short_path "$path")"
        if [[ ! -e "$path" || -L "$path" ]] || is_denied "$path"; then
            printf '   \033[31m%s\033[0m %s\n' "${MSG[DELETE_FAILED]}" "$shown"; fail=$((fail + 1)); continue
        fi
        if [[ "$DRY_RUN" == true ]]; then
            printf '   \033[36m%s\033[0m rm -rf -- %s\n' "${MSG[DRY_RUN_TAG]}" "$shown"; ok=$((ok + 1)); continue
        fi
        if rm -rf -- "$path" 2>/dev/null; then
            printf '   \033[31m%s\033[0m %s\n' "${MSG[DELETED]}" "$shown"; ok=$((ok + 1))
        else
            printf '   \033[31m%s\033[0m %s\n' "${MSG[DELETE_FAILED]}" "$shown"; fail=$((fail + 1))
        fi
    done < "$PICK_FILE"
    printf '\n\033[36m%s\033[0m %s' "${MSG[DONE]}" "$ok"
    (( fail == 0 )) || printf ' (%s failed)' "$fail"
    printf '\n'
}

confirm_and_delete() {
    # 勾选 → 输入确认词 → 永久删除
    if [[ ! -s "$FINAL_FILE" ]]; then
        printf '   \033[33m%s\033[0m\n' "${MSG[NO_CANDIDATES]}"
        return 0
    fi
    pick_leftovers
    if [[ ! -s "$PICK_FILE" ]]; then
        printf '\033[33m%s\033[0m\n' "${MSG[CANCELLED]}"
        return 0
    fi
    printf '\n\033[36m%s\033[0m\n' "${MSG[DELETING_HEADER]}"
    local p
    while IFS= read -r p; do [[ -n "$p" ]] && printf '    %s\n' "$(short_path "$p")"; done < "$PICK_FILE"
    if [[ "$DRY_RUN" == true ]]; then
        delete_picked
        return 0
    fi
    printf '%s' "${MSG[CONFIRM_PROMPT]}"
    local confirm_delete
    read -r confirm_delete || confirm_delete=""
    if [[ "$confirm_delete" != "delete" ]]; then
        printf '\033[33m%s\033[0m\n' "${MSG[CANCELLED]}"
        return 0
    fi
    delete_picked
}

# ==============================================================================
# 9. strace 追踪（原 pacrrr）
# ==============================================================================
extract_traced_paths() {
    # 从 strace 输出里抽出 $HOME 下的路径，按标准位置归并到"每个应用一条"
    awk -v home="$HOME" '
        {
            while (match($0, /"[^"]+"/)) {
                path = substr($0, RSTART + 1, RLENGTH - 2)
                $0 = substr($0, RSTART + RLENGTH)
                if (index(path, home) == 1 && path != home && path != home "/") {
                    rel = substr(path, length(home) + 2)
                    split(rel, parts, "/")
                    if (parts[1] == ".config" || parts[1] == ".cache") {
                        if (length(parts[2]) > 0) print home "/" parts[1] "/" parts[2]
                    } else if (parts[1] == ".local" && (parts[2] == "share" || parts[2] == "state")) {
                        if (length(parts[3]) > 0) print home "/" parts[1] "/" parts[2] "/" parts[3]
                    } else if (substr(parts[1], 1, 1) == "." && parts[1] != ".local" && parts[1] != ".config" && parts[1] != ".cache") {
                        print home "/" parts[1]
                    } else {
                        print path
                    }
                }
            }
        }
    ' "$TRACE_FILE" | sort -u
}

run_trace() {
    # run_trace <命令> [参数...]：启动并追踪，结束后 TRACE_FILE 里是 strace 输出
    : > "$TRACE_FILE"
    set -m
    env APPIMAGE_EXTRACT_AND_RUN=1 strace -f -e trace=%file -o "$TRACE_FILE" "$@" >/dev/null 2>&1 &
    local pid=$!
    set +m
    disown "$pid" 2>/dev/null || true

    printf '%s \033[33m%s\033[0m\n' "${MSG[TRACE_START]}" "$*"
    local i prev=0 stable=0 cur
    if [[ "$TRACE_KEEP_ALIVE" == true ]]; then
        printf '\033[33m%s\033[0m\n' "${MSG[TRACE_KEEP_HINT]}"
        while kill -0 "$pid" 2>/dev/null; do
            read -r -t 1 && break
        done
    else
        printf '\033[33m%s %ss\033[0m\n' "${MSG[TRACE_TIMEOUT_HINT]}" "$TRACE_TIMEOUT"
        for ((i = 1; i <= TRACE_TIMEOUT; i++)); do
            read -r -t 1 && break
            kill -0 "$pid" 2>/dev/null || break
            cur=$(extract_traced_paths | wc -l)
            if (( cur > 0 )); then
                if (( cur == prev )); then
                    stable=$((stable + 1))
                    (( stable >= 2 )) && break
                else
                    stable=0
                fi
            fi
            prev=$cur
        done
    fi

    if kill -0 "$pid" 2>/dev/null; then
        printf '\033[36m%s\033[0m\n' "${MSG[TRACE_ANALYZING]}"
        kill -TERM -- "-$pid" 2>/dev/null || true
        sleep 0.5
        kill -KILL -- "-$pid" 2>/dev/null || true
    fi
}

collect_traced_paths() {
    # 把追踪结果过一遍豁免名单，放进 TRACED_PATHS
    local p
    TRACED_PATHS=()
    while IFS= read -r p; do
        [[ -n "$p" ]] || continue
        is_denied "$p" && continue
        TRACED_PATHS+=("$p")
    done < <(extract_traced_paths)
    (( ${#TRACED_PATHS[@]} > 0 )) || printf '\033[33m%s\033[0m\n' "${MSG[TRACE_NO_PATHS]}"
}

# ==============================================================================
# 10. 卸载
# ==============================================================================
uninstall_packages() {
    local rc=0
    if (( ${#PAC_PKGS[@]} > 0 )); then
        printf '\n\033[34m%s\033[0m\n' "${MSG[REMOVING_PAC]}"
        printf '   %s\n' "${PAC_PKGS[*]}"
        if [[ "$DRY_RUN" == true ]]; then
            printf '   \033[36m%s\033[0m %s -Rns %s\n' "${MSG[DRY_RUN_TAG]}" "$PKG_MGR" "${PAC_PKGS[*]}"
        else
            "$PKG_MGR" -Rns "${PAC_PKGS[@]}" || rc=1
        fi
    fi
    if (( ${#FPK_PKGS[@]} > 0 )); then
        printf '\n\033[36m%s\033[0m\n' "${MSG[REMOVING_FPK]}"
        printf '   %s\n' "${FPK_PKGS[*]}"
        if [[ "$DRY_RUN" == true ]]; then
            printf '   \033[36m%s\033[0m flatpak uninstall %s\n' "${MSG[DRY_RUN_TAG]}" "${FPK_PKGS[*]}"
        else
            flatpak uninstall "${FPK_PKGS[@]}" || rc=1
        fi
    fi
    return $rc
}

# ==============================================================================
# 11. 包模式：选包 → (追踪) → 卸载 → 清残留
# ==============================================================================
select_packages() {
    PREVIEW_CMD="
line={}
if [[ \"\$line\" == PKG:* ]]; then
    pkg=\$(echo \"\$line\" | awk '{print \$3}')
    ${PKG_MGR} -Qi \"\$pkg\"
elif [[ \"\$line\" == FLTK:* ]]; then
    appid=\$(echo \"\$line\" | awk '{print \$NF}')
    flatpak info \"\$appid\"
fi
"
    local fzf_header="${MSG[HEADER]} | \033[33m${PKG_MGR}\033[0m"
    if [[ "$HAS_FLATPAK" == true ]]; then
        fzf_header+=" & \033[36mFlatpak\033[0m"
    fi

    set +e
    fzf --multi --ansi \
        --preview "$PREVIEW_CMD" \
        --preview-window=down:55%:wrap \
        --height=95% --layout=reverse --border \
        --bind "alt-j:last,alt-k:first" \
        --bind "ctrl-r:reload(\"$SCRIPT_PATH\" --generate-data)" \
        --tiebreak=index \
        --with-nth=2.. \
        --header "$fzf_header" \
        --query "${QUERY_ARGS[*]:-}" \
        < <("$SCRIPT_PATH" --generate-data) \
        > "$TARGET_FILE"
    local fzf_exit=$?
    set -e
    [[ $fzf_exit -eq 0 && -s "$TARGET_FILE" ]]
}

split_selection() {
    PAC_PKGS=(); FPK_PKGS=()
    local line pkg
    while IFS= read -r line; do
        if [[ "$line" == PKG:* ]]; then
            pkg=$(echo "$line" | awk '{print $3}')
            [[ -n "$pkg" ]] && PAC_PKGS+=("$pkg")
        elif [[ "$line" == FLTK:* ]]; then
            pkg=$(echo "$line" | awk '{print $NF}')
            [[ -n "$pkg" ]] && FPK_PKGS+=("$pkg")
        fi
    done < "$TARGET_FILE"
}

package_mode() {
    select_packages || return 0
    split_selection
    (( ${#PAC_PKGS[@]} + ${#FPK_PKGS[@]} > 0 )) || return 0

    collect_metadata

    if [[ "$TRACE_PACKAGES" == true ]]; then
        local p bin
        for p in "${PAC_PKGS[@]:-}"; do
            [[ -n "$p" ]] || continue
            bin=$(pacman -Qlq "$p" 2>/dev/null | awk -F/ '/^\/usr\/bin\/[^/]+$/ { print $NF; exit }')
            if [[ -z "$bin" ]]; then
                printf '\033[33m%s\033[0m %s\n' "${MSG[TRACE_NO_BIN]}" "$p"
                continue
            fi
            # dry-run 只说明会追踪什么，绝不真的启动程序
            if [[ "$DRY_RUN" == true ]]; then
                printf '   \033[36m%s\033[0m %s %s\n' "${MSG[DRY_RUN_TAG]}" "${MSG[DRY_RUN_TRACE]}" "$bin"
                continue
            fi
            run_trace "$bin"
        done
        [[ "$DRY_RUN" == true ]] || collect_traced_paths
    fi

    if [[ "$SCAN_ONLY" == true ]]; then
        scan_leftovers
        print_candidates
        return 0
    fi

    if [[ "$DRY_RUN" == true ]]; then
        uninstall_packages
        scan_leftovers
        print_candidates
        return 0
    fi

    if ! uninstall_packages; then
        printf '\033[33m%s\033[0m\n' "${MSG[UNINSTALL_FAILED]}" >&2
        return 1
    fi

    [[ "$CLEAN_MODE" == "no" ]] && return 0

    printf '\n%s' "${MSG[CLEAN_ASK]}"
    local answer
    read -r answer || answer="n"
    case "${answer:-Y}" in
        y|Y|yes|YES) ;;
        *) return 0 ;;
    esac

    scan_leftovers
    confirm_and_delete
}

# ==============================================================================
# 12. 命令模式：追踪任意命令（原 pacrrr）
# ==============================================================================
trace_help() {
    cat <<EOF
${MSG[TRACE_HELP]}

${MSG[TRACE_OPT_TIMEOUT]}
${MSG[TRACE_OPT_KEEP]}
EOF
}

trace_command_mode() {
    while (( $# > 0 )); do
        case "$1" in
            -h|--help) trace_help; return 0 ;;
            -k|--keep-alive) TRACE_KEEP_ALIVE=true; shift ;;
            -t|--timeout)
                if [[ -n "${2:-}" && "$2" =~ ^[0-9]+$ ]]; then
                    TRACE_TIMEOUT="$2"; shift 2
                else
                    printf '%s --timeout <秒>\n' "${MSG[ERR_UNKNOWN_OPT]}" >&2
                    return 1
                fi
                ;;
            --) shift; break ;;
            -*) printf '%s %s\n' "${MSG[ERR_UNKNOWN_OPT]}" "$1" >&2; return 1 ;;
            *) break ;;
        esac
    done
    (( $# > 0 )) || { trace_help; return 0; }

    local APP_CMD="$1"
    if ! command -v "$APP_CMD" >/dev/null 2>&1 && [[ ! -x "$APP_CMD" ]]; then
        printf '\033[31m[!] command not found: %s\033[0m\n' "$APP_CMD" >&2
        return 1
    fi

    run_trace "$@"
    collect_traced_paths

    if (( ${#TRACED_PATHS[@]} > 0 )); then
        # 老 pacrrr 的候选只来自追踪结果，这里保持一致
        : > "$CAND_FILE"; : > "$SEEN_FILE"; : > "$FINAL_FILE"
        local p
        for p in "${TRACED_PATHS[@]}"; do
            emit_candidate "$p" "trace" "-" "trace"
        done
        score_and_sort
        confirm_and_delete
    fi

    if [[ "${APP_CMD,,}" == *.appimage ]]; then
        printf '\n%s' "${MSG[APPIMAGE_ASK]}"
        local ans
        read -r ans || ans="n"
        case "${ans:-y}" in
            y|Y|yes|YES)
                if [[ "$DRY_RUN" == true ]]; then
                    printf '   \033[36m%s\033[0m rm -f -- %s\n' "${MSG[DRY_RUN_TAG]}" "$APP_CMD"
                else
                    rm -f -- "$APP_CMD" && printf '   \033[31m%s\033[0m %s\n' "${MSG[DELETED]}" "$APP_CMD"
                fi
                ;;
        esac
        return 0
    fi

    printf '\n%s' "${MSG[UNINSTALL_ASK]}"
    local ans2
    read -r ans2 || ans2="n"
    case "${ans2:-y}" in
        y|Y|yes|YES) ;;
        *) return 0 ;;
    esac

    local app_path pkg_name matches
    app_path="$(command -v -- "$APP_CMD" 2>/dev/null || true)"
    pkg_name=""
    if [[ -n "$app_path" ]]; then
        pkg_name=$(pacman -Qqo "$app_path" 2>/dev/null || true)
    fi
    if [[ -z "$pkg_name" ]]; then
        matches=$("$PKG_MGR" -Qsq "$APP_CMD" 2>/dev/null || true)
        if [[ -z "$matches" ]]; then
            printf '\033[33m%s\033[0m\n' "${MSG[PKG_NOT_FOUND]}"
            return 0
        elif [[ $(printf '%s\n' "$matches" | wc -l) -eq 1 ]]; then
            pkg_name="$matches"
        else
            printf '\033[36m%s\033[0m\n' "${MSG[MULTI_MATCH]}"
            pkg_name=$(printf '%s\n' "$matches" | fzf --prompt="选择要卸载的包 > " --height=40% --layout=reverse || true)
            [[ -n "$pkg_name" ]] || return 0
        fi
    fi

    [[ -n "$pkg_name" ]] || return 0
    PAC_PKGS=("$pkg_name")
    collect_metadata >/dev/null 2>&1 || true
    uninstall_packages
}

# --- 13. 入口 ---
if [[ "$MODE" == "trace_command" ]]; then
    trace_command_mode "${TRACE_ARGS[@]:-}"
else
    package_mode
fi
