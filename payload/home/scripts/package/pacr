# --- 3. 参数解析 ---
SHOW_HELP=false
QUERY_ARGS=()
while (( $# > 0 )); do
    case "$1" in
        -h|--help) SHOW_HELP=true; shift ;;
        --no-clean) CLEAN_MODE=no; shift ;;
        --scan) SCAN_ONLY=true; CLEAN_MODE=no; shift ;;
        --trace) TRACE_PACKAGES=true; shift ;;
        --trace-timeout)
            if [[ -n "${2:-}" && "$2" =~ ^[0-9]+$ ]]; then
                TRACE_TIMEOUT="$2"; shift 2
            else
                printf '%s --trace-timeout <秒>\n' "${MSG[ERR_UNKNOWN_OPT]}" >&2
                exit 1
            fi
            ;;
        --dry-run) DRY_RUN=true; shift ;;
        --no-ai) NO_AI=true; shift ;;
        --trace-command) shift; MODE=trace_command; TRACE_ARGS=("$@"); break ;;
        -*) printf '%s %s\n' "${MSG[ERR_UNKNOWN_OPT]}" "$1" >&2; exit 1 ;;
        *)
            # 只敲一个 help 时当帮助用（否则会被当成搜索词）
            if [[ $# -eq 1 && "$1" == "help" ]]; then
                SHOW_HELP=true
                break
            fi
            QUERY_ARGS+=("$1"); shift ;;
    esac
done

# --- 4. 依赖检查 ---
for cmd in fzf awk sed mktemp find du stat; do
    command -v "$cmd" >/dev/null 2>&1 || { printf '%s %s\n' "${MSG[ERR_DEPS]}" "$cmd" >&2; exit 127; }
done
command -v pacman >/dev/null 2>&1 || { printf '%s\n' "${MSG[ERR_PACMAN]}" >&2; exit 127; }

AUR_HELPER=""
if command -v paru >/dev/null 2>&1; then
    AUR_HELPER="paru"
elif command -v yay >/dev/null 2>&1; then
    AUR_HELPER="yay"
fi
PKG_MGR="${AUR_HELPER:-pacman}"

HAS_FLATPAK=false
command -v flatpak >/dev/null 2>&1 && HAS_FLATPAK=true

if [[ "$SHOW_HELP" == true ]]; then
    cat <<EOF
${MSG[HELP_HEAD]}

${MSG[HELP_BODY]}
EOF
    exit 0
fi

