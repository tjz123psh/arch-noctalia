#!/usr/bin/env bash
# 描述： 统一卸载（Pacman/AUR + Flatpak）+ 家目录残留清理
# Description: Unified removal (Pacman/AUR + Flatpak) with HOME leftover cleanup
# ==============================================================================
# 包模式（pacr [关键词]）：
#   1. fzf 多选要卸载的包（Pacman/AUR 与 Flatpak 同屏）
#   2. 卸载前先收集包元数据（pacman -Qi / -Qlq、flatpak info）—— 卸载后就查不到了
#   3. --trace 时对选中的包先跑一次 strace 追踪（应用还装着才能跑）
#   4. 卸载：paru/yay -Rns、flatpak uninstall
#   5. 卸载成功后（默认问一句，--no-clean 跳过）：按元数据派生关键词枚举家目录候选，
#      加上追踪到的真实路径，fzf 勾选，输入确认词后【永久删除】（rm -rf，不进回收站）
#
# 命令模式（pacr --trace-command <命令> [参数]，也就是原来的 pacrrr）：
#   保留原顺序：追踪 → 勾选 → 永久删除 → 询问是否用包管理器卸载。
#
# 安全边界：只动家目录；豁免名单在枚举前与删除前各校验一次；删除前逐条确认路径仍存在。
#   候选枚举与豁免名单移植自 shorin-pac（GPL-3.0-or-later，作者 SHORiN-KiWATA）的 bin/pacr。
# ==============================================================================
set -euo pipefail

SCRIPT_PATH=$(readlink -f "$0" 2>/dev/null || realpath "$0" 2>/dev/null || echo "$0")
SHELL="$(grep -m 1 -E '^/.*/bash$' /etc/shells || echo "/bin/bash")"
export SHELL
SCRIPT_DIR="$(cd -- "$(dirname -- "$SCRIPT_PATH")" && pwd -P)"
LEFTOVER_PROMPT=""
for _cand in \
    "$SCRIPT_DIR/share/prompts/leftover-scan.md" \
    "$SCRIPT_DIR/../share/prompts/leftover-scan.md" \
    "/usr/share/pac/prompts/leftover-scan.md"
do
    if [[ -f "$_cand" ]]; then
        LEFTOVER_PROMPT="$_cand"
