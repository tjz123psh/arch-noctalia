{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "builtin",
    "source": "arch_small",
    "padding": {
      "top": 1,
      "right": 4,
      "left": 2
    },
    "color": {
      "1": "#d7c763",
      "2": "#d0c763"
    }
  },
  "display": {
    "separator": "  ",
    "color": {
      "keys": "#d7c770",
      "title": "#d0c7a2"
    },
    "percent": {
      "color": {
        "green": "#a8d0b5",
        "yellow": "#d7c770",
        "red": "#ffb4ab"
      }
    },
    "key": {
      "width": 10
    }
  },
  "modules": [
    "title",
    "separator",
    "os",
    "kernel",
    "uptime",
    "packages",
    "shell",
    "wm",
    "terminal",
    "cpu",
    "memory",
    "disk",
    "localip",
    "break",
    "colors"
  ]
}
