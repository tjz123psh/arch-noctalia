{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

  // ===== 外观 =====
  "logo": {
    "type": "builtin",
    "source": "arch",
    "padding": { "top": 1, "right": 4, "left": 2 },
    "color": { "1": "#63cafc", "2": "#63c8db" }
  },
  "display": {
    "separator": " ",
    "key": { "width": 0 },
    "percent": {
      "color": { "green": "#d6bee5", "yellow": "#9fcafc", "red": "#ffb4ab" }
    }
  },

  // ===== 树形分组：系统 / 桌面 / 硬件 =====
  "modules": [
    { "type": "os", "key": "​", "keyColor": "#bac8db" },
    "break",
    { "type": "kernel", "key": "├─ KER", "keyColor": "#9fcafc" },
    { "type": "packages", "key": "├─ PAK", "keyColor": "#9fcafc", "format": "{pacman}" },
    { "type": "title", "key": "└─ USR", "keyColor": "#9fcafc" },
    "break",
    { "type": "wm", "key": "WM", "keyColor": "#bac8db" },
    { "type": "shell", "key": "├─ SHE", "keyColor": "#9fcafc" },
    { "type": "terminal", "key": "├─ TER", "keyColor": "#9fcafc" },
    { "type": "font", "key": "└─ TFO", "keyColor": "#9fcafc" },
    "break",
    { "type": "host", "key": "PC", "keyColor": "#bac8db" },
    { "type": "cpu", "key": "├─ CPU", "keyColor": "#9fcafc" },
    { "type": "memory", "key": "├─ MEM", "keyColor": "#9fcafc" },
    { "type": "gpu", "key": "├─ GPU", "keyColor": "#9fcafc" },
    { "type": "display", "key": "├─ MON", "keyColor": "#9fcafc" },
    { "type": "disk", "key": "├─ DIS", "keyColor": "#9fcafc", "folders": ["/"] },
    { "type": "battery", "key": "└─ BAT", "keyColor": "#9fcafc" }
  ]
}
