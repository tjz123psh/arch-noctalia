{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "builtin",
    "source": "arch_small",
    "padding": {
      "top": 1,
      "right": 4,
      "left": 2
    },
    "color": {
      "1": "#63cafc",
      "2": "#63c8db"
    }
  },
  "display": {
    "separator": "  ",
    "color": {
      "keys": "#9fcafc",
      "title": "#bac8db"
    },
    "percent": {
      "color": {
        "green": "#d6bee5",
        "yellow": "#9fcafc",
        "red": "#ffb4ab"
      }
    },
    "key": {
      "width": 10
    }
  },
  "modules": [
      "title",
      "separator",
      "os",
      "host",
      "kernel",
      "uptime",
      "packages",
      "shell",
      "display",
      "wm",
      "terminal",
      "cpu",
      "gpu",
      "memory",
      "swap",
      "disk",
      "battery",
      "localip",
      "break",
      "colors"
    ]
}
