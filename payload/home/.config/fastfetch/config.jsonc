{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

  // ===== 外观 =====
  // logo：官方 Arch 标志图片（kitty 图像协议）。图片按单元格比例做了透明留白，
  // 不会像之前那样被裁掉底部。想回内置 ASCII 版就把 logo 段换成下面注释里的。
  "logo": {
    "type": "kitty",
    "source": "~/.config/fastfetch/arch-logo.png",
    "width": 12,
    "height": 8,
    "padding": { "top": 1, "right": 3, "left": 1 }
  },
  // "logo": {
  //   "type": "builtin",
  //   "source": "arch",
  //   "padding": { "top": 1, "right": 4, "left": 2 },
  //   "color": { "1": "#63cafc", "2": "#63c8db" }
  // },
  "display": {
    "separator": " ",
    "key": { "width": 0 },
    "percent": {
      "color": { "green": "#d6bee5", "yellow": "#9fcafc", "red": "#ffb4ab" }
    }
  },

  // ===== 树形分组：系统 / 桌面 / 硬件 =====
  "modules": [
    { "type": "os", "key": "​", "keyColor": "#efe7d6" },
    "break",
    { "type": "kernel", "key": "├─    KER  ", "keyColor": "#d8b36a" },
    { "type": "packages", "key": "├─    PAK  ", "keyColor": "#d8b36a", "format": "{pacman}" },
    { "type": "title", "key": "└─    USR  ", "keyColor": "#d8b36a" },
    "break",
    { "type": "wm", "key": "WM", "keyColor": "#efe7d6" },
    { "type": "shell", "key": "├─    SHE  ", "keyColor": "#d8b36a" },
    { "type": "terminal", "key": "├─    TER  ", "keyColor": "#d8b36a" },
    { "type": "command", "key": "└─    TFO  ", "keyColor": "#d8b36a", "text": "fc-match -f '%{family}' monospace" },
    "break",
    { "type": "host", "key": "PC", "keyColor": "#efe7d6" },
    { "type": "cpu", "key": "├─    CPU  ", "keyColor": "#d8b36a" },
    { "type": "memory", "key": "├─    MEM  ", "keyColor": "#d8b36a" },
    { "type": "gpu", "key": "├─  󰢮  GPU  ", "keyColor": "#d8b36a" },
    { "type": "display", "key": "├─  󰍹  MON  ", "keyColor": "#d8b36a" },
    { "type": "disk", "key": "├─    DIS  ", "keyColor": "#d8b36a", "folders": ["/"] },
    { "type": "battery", "key": "└─    BAT  ", "keyColor": "#d8b36a" }
  ]
}
