// —— 输入设备（键盘/触摸板/鼠标） ——

// ══════════════════════════════════════════════════════════════
//  niri 26.04 — 二次元精致桌面
//  分层：壁纸 → 模糊面板 → 卡片 → 文字图标
//  改完保存即热重载
// ══════════════════════════════════════════════════════════════

input {
    keyboard {
        xkb {
            layout "us"
        }
        numlock
        // 键盘长按重复速度（与物理机一致：200ms 延迟 + 50 次/秒）
        repeat-delay 200
        repeat-rate 50
    }
    touchpad {
        tap
        natural-scroll
    }
    // 鼠标加速（与物理机一致：关闭）
    mouse {
        accel-speed 0.0
    }
    focus-follows-mouse
    warp-mouse-to-focus
}
