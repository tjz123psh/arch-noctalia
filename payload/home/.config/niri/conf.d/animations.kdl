// —— 动画 ——

// ══════════════════════════════════════════════════════════════
//  动效：弹簧曲线 + 自定义着色器（不照搬默认）
//  · 工作区/视线移动 → 弹簧（跟手、收尾柔和）
//  · 窗口开关 → 本机 fluid-v1 明显柔韧试样（安装器尚未更新）
// ══════════════════════════════════════════════════════════════
animations {
    // ══════════════════════════════════════════════════════════════
    //  动效总纲：
    //   · 直接操作类（工作区/视线/窗口移动、缩放）→ 弹簧，跟手、不拖沓
    //   · 开窗 → 460ms可见舒展 + 单次回弹；截图 UI 保持原样
    //   · 关窗 → 340ms向下收拢，保留可见过程后再淡出
    //   · 大场景（概览）→ 软一点的弹簧，收尾有一点回弹，显得有生命
    // ══════════════════════════════════════════════════════════════

    // 工作区切换：比窗口开合更利落，但不再一闪而过；保留原生手势接续。
    workspace-switch {
        spring damping-ratio=0.92 stiffness=300 epsilon=0.0001
    }

    // 本机试样 fluid-v1：460ms 舒展；线性时间只由 shader 做一次运动设计。
    // t² 延后主要动作；单次过冲在约337ms达到峰值，最后约123ms柔和落稳。
    // 从88%宽/84%高展开，上浮32px；峰值约102%宽/102.6%高，不反复弹跳。
    window-open {
        duration-ms 460
        curve "linear"
        custom-shader r"
            vec4 open_color(vec3 coords_geo, vec3 size_geo) {
                float t = clamp(niri_clamped_progress, 0.0, 1.0);
                float u = t * t - 1.0;
                float grow = 1.0 + 3.3 * u * u * u + 2.3 * u * u;

                vec2 scale = mix(vec2(0.88, 0.84), vec2(1.0), grow);
                vec2 offset = vec2(0.0, 32.0 * (1.0 - grow) / max(size_geo.y, 1.0));
                vec2 sample_geo = (coords_geo.xy - vec2(0.5) - offset) / scale + vec2(0.5);
                coords_geo = vec3(sample_geo, 1.0);
                vec3 coords_tex = niri_geo_to_tex * coords_geo;

                vec4 color = vec4(0.0);
                if (0.0 <= coords_geo.x && coords_geo.x <= 1.0
                        && 0.0 <= coords_geo.y && coords_geo.y <= 1.0) {
                    color = texture2D(niri_tex, coords_tex.xy);
                }

                // 约147ms显清楚，余下的舒展和回弹都可见；保持预乘透明度。
                float opacity = smoothstep(0.0, 0.32, t);
                return color * opacity;
            }
        "
    }

    // 关闭不是打开倒放：340ms向下轻收，前约75ms保留原不透明度，再连续淡出。
    // 保留原 close 采样方式：不加0..1几何裁切，避免历史上的整窗透明问题。
    window-close {
        duration-ms 340
        curve "linear"
        custom-shader r"
            vec4 close_color(vec3 coords_geo, vec3 size_geo) {
                float t = clamp(niri_clamped_progress, 0.0, 1.0);
                float shrink = smoothstep(0.0, 1.0, t);

                vec2 scale = mix(vec2(1.0), vec2(0.84, 0.90), shrink);
                scale.y -= 0.048 * shrink * (1.0 - shrink);
                vec2 offset = vec2(0.0, 30.0 * shrink / max(size_geo.y, 1.0));
                coords_geo = vec3((coords_geo.xy - vec2(0.5) - offset) / scale + vec2(0.5), 1.0);
                vec3 coords_tex = niri_geo_to_tex * coords_geo;
                vec4 color = texture2D(niri_tex, coords_tex.xy);

                // 中途仍保留约71%原不透明度，让收拢过程看得清，不留长透明尾巴。
                float opacity = 1.0 - smoothstep(0.22, 1.0, t);
                return color * opacity;
            }
        "
    }

    // 本机 resize-v1：最大化/还原及尺寸变化，用更舒展的原生弹簧。
    // 横向视线、让位/补位和尺寸变化保持同值；保留原生速度接续。
    // 同样会影响普通横移、窗口移动和列宽切换，需一起体验是否拖手。
    // 开/关窗 shader 和时长原样保留；本试样不叠加额外纹理拉伸或淡出。
    horizontal-view-movement {
        spring damping-ratio=0.90 stiffness=180 epsilon=0.0001
    }

    window-movement {
        spring damping-ratio=0.90 stiffness=180 epsilon=0.0001
    }

    window-resize {
        spring damping-ratio=0.90 stiffness=180 epsilon=0.0001
    }

    // 概览开关：软弹簧 + 轻微回弹，像镜头推拉
    overview-open-close {
        spring damping-ratio=0.90 stiffness=280 epsilon=0.0001
    }

    // 配置提示 / 退出确认：小东西，弹一点更活泼
    config-notification-open-close {
        spring damping-ratio=0.72 stiffness=950 epsilon=0.001
    }

    exit-confirmation-open-close {
        spring damping-ratio=0.72 stiffness=520 epsilon=0.01
    }

    // 截图 UI：淡入要快，不能挡着人框选
    screenshot-ui-open {
        duration-ms 190
        curve "cubic-bezier" 0.2 0.9 0.3 1.0
    }

    recent-windows-close {
        spring damping-ratio=1.0 stiffness=500 epsilon=0.001
    }
}
