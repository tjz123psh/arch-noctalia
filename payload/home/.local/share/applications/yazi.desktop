[Desktop Entry]
Name=Yazi 文件管理器
Comment=终端文件管理器（在 kitty 里打开）
Icon=yazi
Terminal=false
TryExec=yazi
Exec=kitty --class yazi -e yazi %f
StartupWMClass=yazi
Type=Application
MimeType=inode/directory
Categories=System;FileManager;FileTools;ConsoleOnly;
Keywords=File;Manager;Explorer;Browser;Launcher;文件;管理器;浏览;
