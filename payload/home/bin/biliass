#!/usr/bin/env bash
# biliass 包装脚本（arch-noctalia 提供）
# 用途：mpv 的 bdanmaku 脚本把 B 站弹幕 XML 转成 ASS 时调用 `biliass`，
#      而本机 biliass 装在独立 venv 里（不污染系统 Python），所以这里做一层转发。
# 首次调用会自动创建 venv 并安装 biliass（约 10 秒，之后就走缓存）。
set -euo pipefail
VENV="${XDG_DATA_HOME:-$HOME/.local/share}/mpv-danmaku/venv"
if [ ! -x "$VENV/bin/biliass" ]; then
  mkdir -p "$(dirname "$VENV")"
  python -m venv "$VENV"
  "$VENV/bin/pip" install -q --disable-pip-version-check biliass
fi
exec "$VENV/bin/biliass" "$@"
